# CarbonSite environment variables
# Copy to .env.local for development
# All services have free tiers — no paid subscriptions required, no Docker needed

# ─── Database ────────────────────────────────────────────────────────────────
# Dev:  postgresql://postgres:postgres@localhost:5432/carbonsite
# Prod: get connection string from neon.tech (free tier, no credit card needed)
DATABASE_URL="postgresql://user:password@localhost:5432/carbonsite"

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
BETTER_AUTH_SECRET=""          # openssl rand -hex 32
BETTER_AUTH_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000"

# ─── Object Storage (Cloudflare R2) ──────────────────────────────────────────
# Dev:  STORAGE_DRIVER=local writes files to ./uploads/ — no R2 account needed
# Prod: STORAGE_DRIVER=r2 — sign up at cloudflare.com (free: 10 GB/month, zero egress)
STORAGE_DRIVER="local"

R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="carbonsite"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Dev:  EMAIL_DRIVER=console prints emails to terminal
# Prod: EMAIL_DRIVER=resend — sign up at resend.com (free: 3,000 emails/month)
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ─── Push Notifications (Firebase FCM) ───────────────────────────────────────
# Free — requires a Google account + Firebase project (console.firebase.google.com)
# Download service account JSON: Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
