# CarbonSite environment variables.
# Copy to .env.local for development.
# Production should set the same keys in Vercel and the worker runtime.

# Database
# Dev example: postgresql://postgres:postgres@localhost:5432/carbonsite
# Prod example: use a managed Postgres connection string, such as Neon.
DATABASE_URL="postgresql://user:password@localhost:5432/carbonsite"

# Auth (Better Auth)
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000"
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION="false"

# Object storage
# STORAGE_DRIVER=local writes files to ./uploads/ for development.
# STORAGE_DRIVER=r2 uses Cloudflare R2 or another S3-compatible endpoint.
# STORAGE_DRIVER=db stores bytes in Postgres — the zero-cost production
#   default when no bucket is configured ("local" auto-upgrades to "db" in
#   production because serverless filesystems are ephemeral).
STORAGE_DRIVER="local"
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="carbonsite"

# Email
# EMAIL_DRIVER=console prints emails to the terminal in development.
# EMAIL_DRIVER=resend sends transactional emails through Resend.
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# Push notifications
# Firebase Cloud Messaging is used for Flutter notifications.
# Store the full service account JSON as a secret in production.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Route distance
# Default providers use postcodes.io for UK geocoding and OSRM for road distance.
ROUTING_PROVIDER="osrm"
POSTCODES_BASE_URL="https://api.postcodes.io"
OSRM_BASE_URL="https://router.project-osrm.org"

# Redis (optional but recommended for production)
# Enables persistent rate limiting across serverless cold starts.
# If REDIS_URL is not set, rate limiting falls back to Postgres (works but slower).
# For development: Leave empty or use local Redis (redis://localhost:6379)
# For production: Use a managed Redis service:
#   - Upstash (serverless Redis, free tier): https://upstash.com
#   - AWS ElastiCache: https://aws.amazon.com/elasticache/
#   - Heroku Redis: https://elements.heroku.com/addons/heroku-redis
#   - Redis Cloud: https://redis.com/cloud/
# Format: redis://[:password@]host:port or rediss://... for TLS
REDIS_URL=""

# Jobs
# inline processes imports/calculations/reports inside the request, which is the
# safest Vercel-only deployment mode. Set to worker when running `pnpm worker`.
JOB_PROCESSING_MODE="inline"

# Stripe Payment Processing
# Get test keys from https://dashboard.stripe.com/test/apikeys
# Publishable key is public (prefixed pk_test_ or pk_live_)
# Secret key must be kept private (prefixed sk_test_ or sk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51234567890ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmn"
STRIPE_SECRET_KEY="sk_test_4eC39HqLyjWDarhtT7sF6Z8j2xyS6ZZH8byE9kJWh9mEPt3p8V8u"
STRIPE_WEBHOOK_SECRET="whsec_test_1234567890abcdefghijklmnopqrstuvwxyz"

# LLM inference for AI features (auto-categorization, Scope 3 estimation, audit narratives)
#
# Primary: HuggingFace Inference API — free tier, 30k requests/month, no self-hosting required.
#   Sign up at https://huggingface.co/settings/tokens (read token is enough).
HUGGINGFACE_TOKEN=""
#
# Fallback: NVIDIA NIM — used when HUGGINGFACE_TOKEN is unset or HuggingFace fails.
#   Obtain from https://build.nvidia.com (free trial credits available) or point to a
#   self-hosted NIM endpoint if you have one.
NVIDIA_NIM_API_KEY=""
NVIDIA_NIM_BASE_URL="http://localhost:8000"

# GHG Calculation Engine (Phase 1 PoC — ghg-calculator)
# Optional: if set, enables parallel calculation validation and future migration to ghg-calculator.
# For development, run ghg-calculator FastMCP server locally:
#   git clone https://github.com/carbonpathio/ghg-calculator.git
#   cd ghg-calculator && pip install -e . && ghg-calculator-mcp
# For production deployment, use Docker:
#   docker run -p 9000:9000 ghg-calculator:latest
GHG_CALCULATOR_API_URL=""

# Accounting Integrations (optional)
# All three are OAuth 2.0 flows for reading invoices and company data

# QuickBooks Accounting Integration
# Register OAuth app at https://developer.intuit.com/app/developer/myapps
# Scopes: com.intuit.quickbooks.accounting
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_REDIRECT_URI="http://localhost:3000/api/auth/quickbooks/callback"

# Sage Accounting Integration
# Register OAuth app at https://developer.sage.com/
# Scopes: full_access
SAGE_CLIENT_ID=""
SAGE_CLIENT_SECRET=""
SAGE_REDIRECT_URI="http://localhost:3000/api/auth/sage/callback"

# Xero Accounting Integration
# Register OAuth app at https://developer.xero.com/app/manage
# Scopes: offline_access, accounting.transactions.read (read invoices)
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="http://localhost:3000/api/auth/xero/callback"

# OIDC / SSO Configuration (optional)
# Supported providers: google, okta, azure, generic
# Register app in your identity provider and configure redirect URI:
#   https://your-domain.com/api/auth/callback/oidc
OIDC_PROVIDER_ID=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_ISSUER_URL=""  # e.g., https://accounts.google.com for Google
OIDC_SCOPE="openid email profile"

# Optional: Map identity provider groups to CarbonSite roles
# Format: JSON object { "provider-group": "role" }
# Example: {"admin-group":"admin","editor-group":"editor","viewer-group":"viewer"}
OIDC_ROLE_MAPPING=""

# n8n Workflow Webhooks (optional)
# Create workflows in n8n.cloud and add webhook URLs here for CarbonSite to call
N8N_WEBHOOK_REPORTS=""
N8N_WEBHOOK_SUBMISSIONS=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
