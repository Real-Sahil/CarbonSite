# CarbonSite environment variables.
# Copy to .env.local for development.
# Production should set the same keys in Vercel and the worker runtime.

# Database
# Dev example: postgresql://postgres:postgres@localhost:5432/carbonsite
# Prod example: use a managed Postgres connection string, such as Neon.
DATABASE_URL="postgresql://user:password@localhost:5432/carbonsite"

# Auth (Better Auth)
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000"
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION="false"

# Object storage
# STORAGE_DRIVER=local writes files to ./uploads/ for development.
# STORAGE_DRIVER=r2 uses Cloudflare R2 or another S3-compatible endpoint.
# STORAGE_DRIVER=db stores bytes in Postgres — the zero-cost production
#   default when no bucket is configured ("local" auto-upgrades to "db" in
#   production because serverless filesystems are ephemeral).
STORAGE_DRIVER="local"
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="carbonsite"

# Email
# EMAIL_DRIVER=console prints emails to the terminal in development.
# EMAIL_DRIVER=resend sends transactional emails through Resend.
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# Push notifications
# Firebase Cloud Messaging is used for Flutter notifications.
# Store the full service account JSON as a secret in production.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Route distance
# Default providers use postcodes.io for UK geocoding and OSRM for road distance.
ROUTING_PROVIDER="osrm"
POSTCODES_BASE_URL="https://api.postcodes.io"
OSRM_BASE_URL="https://router.project-osrm.org"

# Jobs
# inline processes imports/calculations/reports inside the request, which is the
# safest Vercel-only deployment mode. Set to worker when running `pnpm worker`.
JOB_PROCESSING_MODE="inline"

# Stripe Payment Processing
# Get test keys from https://dashboard.stripe.com/test/apikeys
# Publishable key is public (prefixed pk_test_ or pk_live_)
# Secret key must be kept private (prefixed sk_test_ or sk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51234567890ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmn"
STRIPE_SECRET_KEY="sk_test_4eC39HqLyjWDarhtT7sF6Z8j2xyS6ZZH8byE9kJWh9mEPt3p8V8u"
STRIPE_WEBHOOK_SECRET="whsec_test_1234567890abcdefghijklmnopqrstuvwxyz"

# NVIDIA NIM (LLM inference for AI features)
# NVIDIA_NIM_API_KEY can be obtained from https://build.nvidia.com or self-hosted NIM
# NVIDIA_NIM_BASE_URL points to the NIM API endpoint (local or cloud)
# Features: auto-categorization, anomaly detection, audit narrative generation
NVIDIA_NIM_API_KEY=""
NVIDIA_NIM_BASE_URL="http://localhost:8000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
