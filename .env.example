# CarbonSite environment variables
# Copy to .env.local for development
# All services have free tiers — no paid subscriptions required, no Docker needed

# ─── Database ────────────────────────────────────────────────────────────────
# Dev:  postgresql://postgres:postgres@localhost:5432/carbonsite
# Prod: get connection string from neon.tech (free tier, no credit card)
DATABASE_URL="postgresql://user:password@localhost:5432/carbonsite"

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
BETTER_AUTH_SECRET=""              # openssl rand -hex 32
BETTER_AUTH_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000"

# ─── Object Storage ──────────────────────────────────────────────────────────
# STORAGE_DRIVER=local  → writes files to ./uploads/ (no account needed for dev)
# STORAGE_DRIVER=r2     → Cloudflare R2 (free: 10 GB/month, zero egress)
STORAGE_DRIVER="local"

STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="carbonsite"

# ─── Email ────────────────────────────────────────────────────────────────────
# EMAIL_DRIVER=console  → prints emails to terminal (dev)
# EMAIL_DRIVER=resend   → sends via Resend API (prod, resend.com free: 3k/month)
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ─── Push Notifications (Firebase FCM for Flutter) ───────────────────────────
# Free — requires a Google account + Firebase project (console.firebase.google.com)
# Download service account JSON: Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
