# ghg-calculator FastMCP server for CarbonSite PoC
# Wraps the ghg-calculator Python package as an HTTP API

FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn==0.24.0 \
    pydantic==2.5.0 \
    httpx==0.25.0

# Clone and install ghg-calculator from GitHub
# For production, pin to a specific commit/tag
RUN git clone --depth=1 https://github.com/carbonpathio/ghg-calculator.git . && \
    pip install --no-cache-dir -e .

# Copy FastMCP wrapper
COPY workers/ghg-calculator-server.py .

# Health check endpoint
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD curl -f http://localhost:9000/info || exit 1

EXPOSE 9000

CMD ["python", "ghg-calculator-server.py"]
