# Copy to .env.services and fill in values before running docker-compose.services.yml

# DocuSeal
DOCUSEAL_DATABASE_URL=postgresql://carbonsite:password@host:5432/docuseal
DOCUSEAL_SECRET_KEY=change-me-to-a-long-random-string

# Android SMS Gateway (physical device or relay)
# After installing the APK, the device exposes a local API
# For cloud relay, register at https://sms.capcom.me
ANDROID_SMS_GATEWAY_URL=http://192.168.1.x:8080
ANDROID_SMS_GATEWAY_USER=admin
ANDROID_SMS_GATEWAY_PASSWORD=change-me
