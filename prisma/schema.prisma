model WebhookDelivery {
  id          String    @id @default(cuid())
  webhookId   String    @map("webhook_id")
  event       String
  payload     Json
  statusCode  Int?      @map("status_code")
  attempts    Int       @default(0)
  succeededAt DateTime? @map("succeeded_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

// Fixed-window rate limit counters, Postgres-backed so they survive process
// restarts and work across multiple Next.js workers. The key encodes the
// semantic bucket + IP address. Rows are replaced atomically via ON CONFLICT.
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @map("reset_at")

  @@map("rate_limit_buckets")
}

// ─── Embodied Carbon ─────────────────────────────────────────────────────────

// Global material library — seeded from ICE/CarboLifeCalc/RICS data.
// GWP values in kgCO2e per kg unless unit specified otherwise.
model EmbodiedMaterial {
  id           String   @id @default(cuid())
  name         String   @unique
  category     String // e.g. "concrete", "steel", "timber", "insulation"
  description  String?
  // Lifecycle stage GWP factors (kgCO2e / declared unit)
  gwpA1A3      Float    @map("gwp_a1_a3") // cradle to gate (required)
  gwpA4        Float?   @map("gwp_a4") // transport to site
  gwpA5        Float?   @map("gwp_a5") // installation
  gwpC1C4      Float?   @map("gwp_c1_c4") // end of life
  gwpD         Float?   @map("gwp_d") // beyond system boundary (reuse/recycling)
  declaredUnit String   @default("kg") @map("declared_unit") // kg | m3 | m2
  density      Float? // kg/m3 — used to convert volume → mass
  source       String   @default("ICE v3.0") // data source
  sourceUrl    String?  @map("source_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  epdRecords    EpdRecord[]
  carbonRecords EmbodiedCarbonRecord[]

  @@map("embodied_materials")
}

// Organisation-specific EPD (Environmental Product Declaration) uploads.
// Overrides the global material factor for that org.
model EpdRecord {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  materialId        String?   @map("material_id") // null = custom material not in global lib
  productName       String    @map("product_name")
  manufacturer      String?
  validFrom         DateTime? @map("valid_from")
  validUntil        DateTime? @map("valid_until")
  gwpA1A3           Float     @map("gwp_a1_a3")
  gwpA4             Float?    @map("gwp_a4")
  gwpA5             Float?    @map("gwp_a5")
  gwpC1C4           Float?    @map("gwp_c1_c4")
  gwpD              Float?    @map("gwp_d")
  declaredUnit      String    @default("kg") @map("declared_unit")
  storageKey        String?   @map("storage_key") // PDF stored in R2/db
  submittedByUserId String?   @map("submitted_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  material      EmbodiedMaterial?      @relation(fields: [materialId], references: [id])
  submittedBy   User?                  @relation("EpdSubmittedBy", fields: [submittedByUserId], references: [id])
  carbonRecords EmbodiedCarbonRecord[]

  @@index([organizationId])
  @@map("epd_records")
}

// Per-project embodied carbon record — each material quantity on a project.
model EmbodiedCarbonRecord {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  projectId         String?  @map("project_id")
  reportingPeriodId String?  @map("reporting_period_id")
  materialId        String?  @map("material_id")
  epdId             String?  @map("epd_id") // EPD overrides global material
  description       String?
  quantity          Float
  unit              String   @default("kg")
  // Computed outputs (stored for audit trail)
  gwpA1A3Used       Float    @map("gwp_a1_a3_used")
  gwpA4Used         Float?   @map("gwp_a4_used")
  totalKgCo2e       Float    @map("total_kg_co2e")
  lifecycleStages   String[] @map("lifecycle_stages") // ["A1-A3","A4","A5"]
  source            String   @default("manual") // manual | ocr | import
  fieldSubmissionId String?  @map("field_submission_id")
  notes             String?
  createdByUserId   String   @map("created_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod?  @relation(fields: [reportingPeriodId], references: [id])
  material        EmbodiedMaterial? @relation(fields: [materialId], references: [id])
  epd             EpdRecord?        @relation(fields: [epdId], references: [id])
  createdBy       User              @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, projectId])
  @@index([organizationId, reportingPeriodId])
  @@map("embodied_carbon_records")
}

// ─── API Keys ────────────────────────────────────────────────────────────────

// Org-scoped API keys for BI tools and integrations.
// The raw key is shown once on creation and never stored — only a SHA-256 hash
// is persisted so that even DB read access cannot recover active credentials.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  name           String
  keyHash        String    @unique @map("key_hash")
  prefix         String
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model BillingSubscription {
  id                     String    @id @default(cuid())
  organizationId         String    @unique @map("organization_id")
  plan                   String    @default("trial")
  status                 String    @default("active")
  trialEndsAt            DateTime? @map("trial_ends_at")
  currentPeriodStart     DateTime  @default(now()) @map("current_period_start")
  currentPeriodEnd       DateTime  @map("current_period_end")
  stripeCustomerId       String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?   @map("stripe_subscription_id")
  defaultPaymentMethodId String?   @map("default_payment_method_id")
  lastPaymentStatus      String?   @map("last_payment_status")
