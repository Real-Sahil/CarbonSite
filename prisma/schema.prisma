// CarbonSite Prisma Schema — MVP
// Methodology: GHG Protocol v2026-01, GWP AR6
// All tenant-owned tables include organization_id. No query may omit it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Identity & Tenancy ──────────────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  emailVerified        Boolean   @default(false) @map("email_verified")
  emailVerifiedAt      DateTime? @map("email_verified_at")
  image                String?
  twoFactorSecret      String?   @map("two_factor_secret")
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  twoFactorBackupCodes String?   @map("two_factor_backed_up_codes")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  memberships                       OrganizationMembership[]
  createdRecords                    ActivityRecord[]             @relation("CreatedByUser")
  createdImports                    ImportBatch[]
  reviewTasks                       ReviewTask[]                 @relation("AssignedTo")
  createdTasks                      ReviewTask[]                 @relation("CreatedBy")
  comments                          Comment[]
  uploadedEvidence                  EvidenceFile[]
  auditLogs                         AuditLog[]
  calculationRuns                   CalculationRun[]
  scenarioRunsCreated               ScenarioRun[]                @relation("ScenarioRunsCreated")
  reports                           Report[]
  snapshots                         PublishedSnapshot[]
  dsarRequestsAsSubject             DsarRequest[]                @relation("DsarSubject")
  dsarRequestsCreated               DsarRequest[]                @relation("DsarRequestedBy")
  targets                           ReductionTarget[]
  ownedInitiatives                  ReductionInitiative[]        @relation("InitiativeOwner")
  createdInitiatives                ReductionInitiative[]        @relation("InitiativeCreator")
  fieldSubmissions                  FieldSubmission[]
  fieldWorkerAssignments            FieldWorkerAssignment[]      @relation("AssignedFieldWorker")
  createdFieldWorkerAssignments     FieldWorkerAssignment[]      @relation("FieldWorkerAssignmentCreator")
  fieldWorkerSiteAssignments        FieldWorkerSiteAssignment[]  @relation("AssignedFieldWorkerSite")
  createdFieldWorkerSiteAssignments FieldWorkerSiteAssignment[]  @relation("FieldWorkerSiteAssignmentCreator")
  contractsCreated                  Contract[]                   @relation("ContractCreator")
  socialValueRecordsCreated         SocialValueRecord[]          @relation("SocialValueCreator")
  classificationReviews             EvidenceClassification[]     @relation("ClassificationReviewer")
  ocrCorrections                    OcrCorrection[]              @relation("OcrCorrectionBy")
  snapshotAssurances                SnapshotAssurance[]          @relation("SnapshotAuditor")
  deviceTokens                      DeviceToken[]
  webhooks                          Webhook[]                    @relation("WebhookCreator")
  snapshotVerifications             PublishedSnapshot[]          @relation("SnapshotVerifiedBy")
  embodiedCarbonRecords             EmbodiedCarbonRecord[]
  supplierInvitesCreated            SupplierInvite[]             @relation("SupplierInviteCreatedBy")
  supplierDataRequestsCreated       SupplierDataRequest[]        @relation("SupplierDataRequestCreatedBy")
  supplierDataRequestsApproved      SupplierDataRequest[]        @relation("SupplierDataRequestApprovedBy")
  supplierReportsReviewed           SupplierReport[]             @relation("SupplierReportReviewedBy")
  epdRecordsSubmitted               EpdRecord[]                  @relation("EpdSubmittedBy")
  projectRoleAssignments            ProjectRoleAssignment[]      @relation("ProjectAssignments")
  createdProjectRoleAssignments     ProjectRoleAssignment[]      @relation("ProjectAssignmentsCreated")
  supplierTagAssignments            SupplierTagAssignment[]      @relation("SupplierTagAssignments")
  supplierCategoryAssignments       SupplierCategoryAssignment[] @relation("SupplierCategoryAssignments")
  customEmissionFactorsCreated      OrganizationEmissionFactor[] @relation("CustomFactorCreator")
  anomaliesAcknowledged             SupplierAnomaly[]            @relation("AnomalyAcknowledger")
  scope3EstimatesAccepted           Scope3Estimate[]             @relation("Scope3EstimatesAccepted")
  ssoSessions                       SsoSession[]                 @relation("SsoSessions")
  invoiceAnomaliesResolved          InvoiceAnomaly[]             @relation("InvoiceAnomalyResolutions")
  investigatedAnalyses              CausalAnalysis[]             @relation("causalInvestigator")

  platformMembership PlatformMembership?

  baseYearsCreated         BaseYear[]              @relation("BaseYearCreator")
  structuralChangesCreated StructuralChange[]      @relation("StructuralChangeCreator")
  recalculationsCreated    BaseYearRecalculation[] @relation("RecalcCreator")
  recalculationsApproved   BaseYearRecalculation[] @relation("RecalcApprover")
  restatementsCreated      Restatement[]           @relation("RestatementCreator")
  permitsOwned             EnvironmentalPermit[]    @relation("PermitOwner")
  permitsCreated           EnvironmentalPermit[]    @relation("PermitCreator")
  legalRegisterOwned       LegalRegisterEntry[]     @relation("LegalRegisterOwner")
  legalRegisterCreated     LegalRegisterEntry[]     @relation("LegalRegisterCreator")
  incidentsReported        EnvironmentalIncident[]  @relation("IncidentReporter")
  incidentsOwned           EnvironmentalIncident[]  @relation("IncidentOwner")
  incidentsCreated         EnvironmentalIncident[]  @relation("IncidentCreator")
  actionsAssigned          CorrectiveAction[]       @relation("ActionAssignee")
  actionsVerified          CorrectiveAction[]       @relation("ActionVerifier")
  actionsCreated           CorrectiveAction[]       @relation("ActionCreator")
  aspectsOwned             EnvironmentalAspect[]    @relation("AspectOwner")
  aspectsCreated           EnvironmentalAspect[]    @relation("AspectCreator")
  biodiversityCreated      BiodiversityAssessment[] @relation("BiodiversityCreator")
  speciesRecordsCreated    ProtectedSpeciesRecord[] @relation("SpeciesRecordCreator")
  managementPlansCreated   HabitatManagementPlan[]  @relation("ManagementPlanCreator")

  // Better Auth session tables
  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id        String    @id
  expiresAt DateTime  @map("expires_at")
  token     String    @unique
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  userId    String    @map("user_id")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  passwordChangedAt     DateTime? @map("password_changed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

model Organization {
  id                           String   @id @default(cuid())
  name                         String
  industry                     String?
  hqCountry                    String?  @map("hq_country")
  reportingCurrency            String   @default("GBP") @map("reporting_currency")
  defaultUnits                 Json?    @map("default_units")
  /// GHG Protocol Chapter 3 consolidation approach. Determines which legal
  /// entities are consolidated and at what share. Changing it is a structural
  /// change that triggers base year recalculation.
  consolidationApproach        ConsolidationApproach @default(operational_control) @map("consolidation_approach")
  plan                         String   @default("trial") @map("plan")
  supplierPasswordRotationDays Int?     @map("supplier_password_rotation_days")
  supplierAccountExpiryDays    Int?     @map("supplier_account_expiry_days")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  memberships                 OrganizationMembership[]
  facilities                  Facility[]
  businessUnits               BusinessUnit[]
  contracts                   Contract[]
  reportingPeriods            ReportingPeriod[]
  activityRecords             ActivityRecord[]
  importBatches               ImportBatch[]
  calculationRuns             CalculationRun[]
  snapshots                   PublishedSnapshot[]
  aggregates                  DashboardAggregate[]
  scenarioRuns                ScenarioRun[]
  routeDistances              RouteDistance[]
  reports                     Report[]
  reviewTasks                 ReviewTask[]
  comments                    Comment[]
  auditLogs                   AuditLog[]
  dsarRequests                DsarRequest[]
  targets                     ReductionTarget[]
  initiatives                 ReductionInitiative[]
  evidenceFiles               EvidenceFile[]
  fieldSubmissions            FieldSubmission[]
  inviteLinks                 InviteLink[]
  supplierInvites             SupplierInvite[]
  supplierDataRequests        SupplierDataRequest[]
  supplierReports             SupplierReport[]
  integrationConnections      IntegrationConnection[]
  fieldWorkerAssignments      FieldWorkerAssignment[]
  fieldWorkerSiteAssignments  FieldWorkerSiteAssignment[]
  socialValueRecords          SocialValueRecord[]
  socialValueTargets          SocialValueTarget[]
  sites                       Site[]                       @relation("OrgSites")
  projects                    Project[]                    @relation("OrgProjects")
  branding                    TenantBranding?
  webhooks                    Webhook[]
  epdRecords                  EpdRecord[]
  embodiedCarbonRecords       EmbodiedCarbonRecord[]
  apiKeys                     ApiKey[]
  billingSubscription         BillingSubscription?
  paymentMethods              PaymentMethod[]
  usageEvents                 UsageEvent[]
  carbonOffsets               CarbonOffset[]
  complianceRecords           ComplianceRecord[]
  carbonBudgets               CarbonBudget[]
  wasteRecords                WasteRecord[]
  sbtiTarget                  SbtiTarget?
  bulkOperations              BulkOperation[]
  calculationSchedules        CalculationSchedule[]
  digestPreferences           DigestPreference[]
  projectRoleAssignments      ProjectRoleAssignment[]
  snapshotAssurances          SnapshotAssurance[]
  reportVerificationTokens    ReportVerificationToken[]
  apiDataSources              ApiDataSource[]
  supplierTags                SupplierTag[]
  supplierCategoryAssignments SupplierCategoryAssignment[]
  iotDevices                  IoTDevice[]
  iotDeviceCredentials        IoTDeviceCredential[]
  meterReadings               MeterReading[]
  customEmissionFactors       OrganizationEmissionFactor[]
  supplierAnomalies           SupplierAnomaly[]
  zapierIntegration           ZapierIntegration?
  auditEvents                 AuditEvent[]
  dataQualityChecks           DataQualityCheck[]
  importBatchQualityScores    ImportBatchQualityScore[]
  stagedExternalData          StagedExternalData[]
  airbyteSyncConnections      AirbyteSyncConnection[]
  scope3EstimationModels      Scope3EstimationModel[]      @relation("EstimationModels")
  scope3Estimates             Scope3Estimate[]             @relation("Scope3Estimates")
  supplierPerformanceOrg      SupplierPerformance[]        @relation("supplierPerformanceOrg")
  supplierPerformanceSupplier SupplierPerformance[]        @relation("supplierPerformanceSupplier")
  supplierPerformanceHistory  SupplierPerformanceHistory[] @relation("supplierPerformanceHistoryOrg")
  auditContexts               AuditContext[]               @relation("AuditContexts")
  ssoConfiguration            SsoConfiguration?            @relation("SsoConfigurations")
  ssoSessions                 SsoSession[]                 @relation("SsoSessions")
  xeroSyncLogs                XeroSyncLog[]
  invoiceRecords              InvoiceRecord[]              @relation("InvoiceRecords")
  invoiceAnomalies            InvoiceAnomaly[]             @relation("InvoiceAnomalies")
  invoiceReconciliations      InvoiceReconciliation[]      @relation("InvoiceReconciliations")
  integrationConfig           IntegrationConfig?
  dbtRuns                     DbtRun[]                     @relation("DbtRuns")
  n8nWorkflows                N8nWorkflow[]                @relation("N8nWorkflows")
  n8nExecutions               N8nExecution[]               @relation("N8nExecutions")
  airbiteConnectors           AirbiteConnector[]           @relation("AirbiteConnectors")
  airbyteSyncLogs             AirbyteSyncLog[]             @relation("AirbyteSyncLogs")
  forecasts                   Forecast[]                   @relation("Forecasts")
  causalInferenceRuns         CausalInferenceRun[]         @relation("CausalInferenceRuns")
  supplierAnalyticOrg         SupplierAnalytic[]           @relation("supplierAnalyticOrg")
  supplierAnalyticSupplier    SupplierAnalytic[]           @relation("supplierAnalyticSupplier")
  emissionsForecasts          EmissionsForecast[]          @relation("forecastOrg")
  modelExplanations           ModelExplanation[]           @relation("explanationOrg")
  causalAnalyses              CausalAnalysis[]             @relation("causalOrg")
  batchJobs                   BatchJob[]                   @relation("batchJobOrg")
  analyticsDashboardCaches    AnalyticsDashboardCache[]    @relation("dashboardCacheOrg")
  legalEntities               LegalEntity[]                @relation("OrgLegalEntities")
  baseYears                   BaseYear[]                   @relation("OrgBaseYears")
  structuralChanges           StructuralChange[]           @relation("OrgStructuralChanges")
  baseYearRecalculations      BaseYearRecalculation[]      @relation("OrgBaseYearRecalcs")
  restatements                Restatement[]                @relation("OrgRestatements")
  environmentalPermits        EnvironmentalPermit[]        @relation("OrgPermits")
  permitConditions            PermitCondition[]            @relation("OrgPermitConditions")
  legalRegisterEntries        LegalRegisterEntry[]         @relation("OrgLegalRegister")
  environmentalIncidents      EnvironmentalIncident[]      @relation("OrgIncidents")
  correctiveActions           CorrectiveAction[]           @relation("OrgCorrectiveActions")
  environmentalAspects        EnvironmentalAspect[]        @relation("OrgAspects")
  biodiversityAssessments     BiodiversityAssessment[]     @relation("OrgBiodiversity")
  habitatParcels              HabitatParcel[]              @relation("OrgHabitatParcels")
  protectedSpeciesRecords     ProtectedSpeciesRecord[]     @relation("OrgSpeciesRecords")
  habitatManagementPlans      HabitatManagementPlan[]      @relation("OrgManagementPlans")
  ecologicalMonitoringEvents  EcologicalMonitoringEvent[]  @relation("OrgMonitoringEvents")

  @@map("organizations")
}

enum OrgRole {
  // Platform & tenant management
  admin
  // Sustainability professionals
  sustainability_director
  sustainability_manager
  // Operations
  operations_manager
  editor
  reviewer
  viewer
  auditor
  // Contract / project / site hierarchy
  contract_manager
  project_manager
  site_manager
  supervisor
  employee
  // External
  client_viewer
  field_worker
  supplier

  @@map("org_role")
}

// ─── Platform Layer ───────────────────────────────────────────────────────────

enum PlatformRole {
  platform_owner
  platform_support
  platform_analyst

  @@map("platform_role")
}

model PlatformMembership {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  role      PlatformRole
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("platform_memberships")
}

// ─── White-Label Branding ─────────────────────────────────────────────────────

model TenantBranding {
  id                  String   @id @default(cuid())
  organizationId      String   @unique @map("organization_id")
  subdomain           String   @unique
  customDomain        String?  @map("custom_domain")
  primaryHex          String   @default("#0f4c8a") @map("primary_hex")
  accentHex           String   @default("#e8f0fe") @map("accent_hex")
  logoStorageKey      String?  @map("logo_storage_key")
  faviconStorageKey   String?  @map("favicon_storage_key")
  reportHeaderLogoKey String?  @map("report_header_logo_key")
  emailFromName       String?  @map("email_from_name")
  emailFromDomain     String?  @map("email_from_domain")
  fontFamily          String   @default("Inter") @map("font_family")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

model OrganizationMembership {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  role           OrgRole
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  terminatedAt   DateTime? @map("terminated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

// Invite links for field workers (external parties, no email/password)
model InviteLink {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  role           OrgRole   @default(field_worker)
  email          String?
  token          String    @unique @default(cuid())
  siteId         String?   @map("site_id")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  usedByUserId   String?   @map("used_by_user_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, email])
  @@map("invite_links")
}

model SupplierInvite {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  email           String
  companyName     String?   @map("company_name")
  token           String    @unique @default(cuid())
  inviteMethod    String    @default("magic-link") @map("invite_method") // "magic-link" or "credentials"
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  usedByUserId    String?   @map("used_by_user_id")
  createdByUserId String    @map("created_by_user_id")
  tags            Json?     @default("[]") // Array of supplier category tags
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("SupplierInviteCreatedBy", fields: [createdByUserId], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("supplier_invites")
}

// ─── Reporting Structure ──────────────────────────────────────────────────────

model FieldWorkerAssignment {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  userId            String   @map("user_id")
  reportingPeriodId String   @map("reporting_period_id")
  facilityId        String?  @map("facility_id")
  assignedByUserId  String   @map("assigned_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User            @relation("AssignedFieldWorker", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy      User            @relation("FieldWorkerAssignmentCreator", fields: [assignedByUserId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  facility        Facility?       @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId, reportingPeriodId])
  @@index([organizationId, userId])
  @@index([organizationId, reportingPeriodId])
  @@map("field_worker_assignments")
}

model Facility {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  country        String?
  region         String?
  addressLine    String?  @map("address_line")
  postcode       String?
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  /// Free-text classification (office, warehouse, depot, plant, retail, data_centre).
  siteType       String?  @map("site_type")
  /// Gross internal floor area, the denominator for per-m2 intensity metrics.
  floorAreaM2    Decimal? @map("floor_area_m2") @db.Decimal(15, 2)
  headcount      Int?
  /// Which legal entity owns or operates this facility. Drives consolidation.
  legalEntityId  String?  @map("legal_entity_id")
  /// Whether the org has operational control. Under the operational control
  /// consolidation approach only controlled facilities are consolidated at 100%.
  operationalControl Boolean @default(true) @map("operational_control")
  /// Date the facility entered the inventory boundary. Activity before this
  /// date belongs to a prior owner and is excluded from consolidated totals.
  operationalFrom DateTime? @map("operational_from") @db.Date
  /// Date the facility left the boundary (divestiture, closure).
  operationalTo   DateTime? @map("operational_to") @db.Date
  externalRef     String?   @map("external_ref")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  legalEntity            LegalEntity?            @relation("LegalEntityFacilities", fields: [legalEntityId], references: [id], onDelete: SetNull)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activityRecords        ActivityRecord[]
  aggregates             DashboardAggregate[]
  submissions            FieldSubmission[]
  fieldWorkerAssignments FieldWorkerAssignment[]
  iotDevices             IoTDevice[]
  emissionsForecasts     EmissionsForecast[]    @relation("forecastFacility")
  causalAnalyses         CausalAnalysis[]       @relation("causalFacility")
  permits                EnvironmentalPermit[]   @relation("FacilityPermits")
  incidents              EnvironmentalIncident[] @relation("FacilityIncidents")
  aspects                EnvironmentalAspect[]   @relation("FacilityAspects")

  @@index([organizationId])
  @@index([organizationId, legalEntityId])
  @@map("facilities")
}

model BusinessUnit {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activityRecords ActivityRecord[]
  aggregates      DashboardAggregate[]
  contracts       Contract[]

  @@index([organizationId])
  @@map("business_units")
}

enum ReportingPeriodType {
  month
  quarter
  year
  custom

  @@map("reporting_period_type")
}

enum ReportingPeriodStatus {
  draft
  published
  locked

  @@map("reporting_period_status")
}

model ReportingPeriod {
  id              String                @id @default(cuid())
  organizationId  String                @map("organization_id")
  type            ReportingPeriodType
  startDate       DateTime              @map("start_date") @db.Date
  endDate         DateTime              @map("end_date") @db.Date
  label           String
  status          ReportingPeriodStatus @default(draft)
  /// Reference values for carbon intensity calculations
  revenueAmount   Decimal?              @map("revenue_amount") @db.Decimal(18, 2)
  revenueCurrency String?               @map("revenue_currency")
  fteCount        Decimal?              @map("fte_count") @db.Decimal(10, 2)
  facilityAreaM2  Decimal?              @map("facility_area_m2") @db.Decimal(15, 2)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  organization              Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activityRecords           ActivityRecord[]
  calculationRuns           CalculationRun[]
  snapshots                 PublishedSnapshot[]
  aggregates                DashboardAggregate[]
  reports                   Report[]
  targets                   ReductionTarget[]        @relation("BaselinePeriod")
  targetPeriods             ReductionTarget[]        @relation("TargetPeriod")
  submissions               FieldSubmission[]
  fieldWorkerAssignments    FieldWorkerAssignment[]
  socialValueRecords        SocialValueRecord[]
  socialValueTargets        SocialValueTarget[]
  embodiedCarbonRecords     EmbodiedCarbonRecord[]
  supplierDataRequests      SupplierDataRequest[]
  calculationSchedules      CalculationSchedule[]
  analyticsDashboardCaches  AnalyticsDashboardCache[]   @relation("dashboardCachePeriod")
  baseYears                 BaseYear[]                  @relation("BaseYearPeriod")

  @@index([organizationId, startDate, endDate])
  @@map("reporting_periods")
}

// ─── Taxonomy & Methodology ───────────────────────────────────────────────────

model EmissionCategory {
  id           String  @id @default(cuid())
  scope        Int
  code         String  @unique
  name         String
  activityType String? @map("activity_type")

  activityRecords             ActivityRecord[]
  emissionFactors             EmissionFactor[]
  customEmissionFactors       OrganizationEmissionFactor[]
  aggregates                  DashboardAggregate[]
  submissions                 FieldSubmission[]
  supplierCategoryAssignments SupplierCategoryAssignment[]
  scope3EstimationModels      Scope3EstimationModel[]      @relation("EstimationModels")
  scope3Estimates             Scope3Estimate[]             @relation("Scope3Estimates")
  supplierReports             SupplierReport[]
  emissionsForecasts          EmissionsForecast[]          @relation("forecastCategory")

  @@map("emission_categories")
}

model MethodologyVersion {
  id         String   @id @default(cuid())
  name       String   @unique
  gwpVersion String   @map("gwp_version")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  calculationRuns CalculationRun[]
  calculations    EmissionCalculation[]

  @@map("methodology_versions")
}

// ─── Imports & Staging ───────────────────────────────────────────────────────

enum ImportState {
  uploaded
  parsing
  mapped
  validating
  needs_attention
  ready_to_commit
  committed
  failed

  @@map("import_state")
}

model ImportBatch {
  id                    String      @id @default(cuid())
  organizationId        String      @map("organization_id")
  reportingPeriodId     String      @map("reporting_period_id")
  templateKey           String      @map("template_key")
  state                 ImportState @default(uploaded)
  sourceFilename        String      @map("source_filename")
  sourceStorageKey      String      @map("source_storage_key")
  sourceChecksum        String      @map("source_checksum")
  mapping               Json?
  rowCount              Int?        @map("row_count")
  errorCount            Int         @default(0) @map("error_count")
  warningCount          Int         @default(0) @map("warning_count")
  errorCsvStorageKey    String?     @map("error_csv_storage_key")
  idempotencyKey        String?     @unique @map("idempotency_key")
  lastProcessedRowIndex Int?        @map("last_processed_row_index")
  createdByUserId       String?     @map("created_by_user_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  organization    Organization             @relation(fields: [organizationId], references: [id])
  createdBy       User?                    @relation(fields: [createdByUserId], references: [id])
  stagedRecords   StagedActivityRecord[]
  activityRecords ActivityRecord[]
  evidence        ImportBatchEvidence[]
  qualityChecks   DataQualityCheck[]
  qualityScore    ImportBatchQualityScore?

  @@index([organizationId, reportingPeriodId, state])
  @@index([organizationId, sourceChecksum])
  @@map("import_batches")
}

enum StagedRecordStatus {
  staged
  excluded
  ready

  @@map("staged_record_status")
}

model StagedActivityRecord {
  id                 String             @id @default(cuid())
  organizationId     String             @map("organization_id")
  importBatchId      String             @map("import_batch_id")
  rowNumber          Int                @map("row_number")
  data               Json
  validationErrors   Json               @default("[]") @map("validation_errors")
  validationWarnings Json               @default("[]") @map("validation_warnings")
  status             StagedRecordStatus @default(staged)
  createdAt          DateTime           @default(now()) @map("created_at")

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([importBatchId, status])
  @@map("staged_activity_records")
}

// ─── Activity Records & Evidence ─────────────────────────────────────────────

enum ReviewStatus {
  draft
  in_review
  approved
  rejected
  pending_info

  @@map("review_status")
}

enum EvidenceStatus {
  missing
  partial
  complete

  @@map("evidence_status")
}

enum Scope2Method {
  location_based
  market_based

  @@map("scope2_method")
}

model ActivityRecord {
  id                        String         @id @default(cuid())
  organizationId            String         @map("organization_id")
  reportingPeriodId         String         @map("reporting_period_id")
  emissionCategoryId        String         @map("emission_category_id")
  activityDate              DateTime?      @map("activity_date") @db.Date
  startDate                 DateTime?      @map("start_date") @db.Date
  endDate                   DateTime?      @map("end_date") @db.Date
  amount                    Decimal        @db.Decimal(18, 6)
  unit                      String
  sourceDescription         String?        @map("source_description")
  facilityId                String?        @map("facility_id")
  businessUnitId            String?        @map("business_unit_id")
  supplierName              String?        @map("supplier_name")
  country                   String?
  region                    String?
  spendAmount               Decimal?       @map("spend_amount") @db.Decimal(18, 2)
  spendCurrency             String?        @map("spend_currency")
  distanceAmount            Decimal?       @map("distance_amount") @db.Decimal(18, 4)
  distanceUnit              String?        @map("distance_unit")
  pickupPostcode            String?        @map("pickup_postcode")
  deliveryPostcode          String?        @map("delivery_postcode")
  pickupPostcodeEncrypted   Json?          @map("pickup_postcode_encrypted")
  deliveryPostcodeEncrypted Json?          @map("delivery_postcode_encrypted")
  pickupLat                 Decimal?       @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng                 Decimal?       @map("pickup_lng") @db.Decimal(10, 7)
  deliveryLat               Decimal?       @map("delivery_lat") @db.Decimal(10, 7)
  deliveryLng               Decimal?       @map("delivery_lng") @db.Decimal(10, 7)
  routeDistanceId           String?        @map("route_distance_id")
  routeDistanceSource       String?        @map("route_distance_source")
  distanceOverrideReason    String?        @map("distance_override_reason")
  transportMode             String?        @map("transport_mode")
  fuelType                  String?        @map("fuel_type")
  refrigerantType           String?        @map("refrigerant_type")
  scope2Method              Scope2Method?  @map("scope2_method")
  biogenicCo2e              Decimal?       @map("biogenic_co2e") @db.Decimal(18, 8)
  /// How this figure was obtained. Assurance providers sample by tier and
  /// ESRS E1 / CDP require disclosure of the primary vs secondary data split.
  dataOrigin                DataOrigin     @default(estimated) @map("data_origin")
  /// Free-text justification required when dataOrigin is proxy or extrapolated.
  dataOriginNote            String?        @map("data_origin_note")
  reviewStatus              ReviewStatus   @default(draft) @map("review_status")
  evidenceStatus            EvidenceStatus @default(missing) @map("evidence_status")
  assumptionNotes           String?        @map("assumption_notes")
  siteId                    String?        @map("site_id")
  contractId                String?        @map("contract_id")
  importBatchId             String?        @map("import_batch_id")
  fieldSubmissionId         String?        @map("field_submission_id")
  createdByUserId           String         @map("created_by_user_id")
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @updatedAt @map("updated_at")

  organization     Organization             @relation(fields: [organizationId], references: [id])
  reportingPeriod  ReportingPeriod          @relation(fields: [reportingPeriodId], references: [id])
  emissionCategory EmissionCategory         @relation(fields: [emissionCategoryId], references: [id])
  facility         Facility?                @relation(fields: [facilityId], references: [id])
  businessUnit     BusinessUnit?            @relation(fields: [businessUnitId], references: [id])
  site             Site?                    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  importBatch      ImportBatch?             @relation(fields: [importBatchId], references: [id])
  routeDistance    RouteDistance?           @relation(fields: [routeDistanceId], references: [id])
  createdBy        User                     @relation("CreatedByUser", fields: [createdByUserId], references: [id])
  calculations     EmissionCalculation[]
  evidence         ActivityRecordEvidence[]
  scenarioDrafts   ScenarioDraft[]          @relation("ScenarioDraftActivityRecord")
  meterReadings    MeterReading[]
  scope3Estimates  Scope3Estimate[]         @relation("ActivityRecordEstimate")

  @@index([organizationId, reportingPeriodId, emissionCategoryId, facilityId, reviewStatus, createdAt])
  @@index([organizationId, routeDistanceId])
  @@index([organizationId, siteId])
  @@index([organizationId, contractId])
  @@map("activity_records")
}

model PostcodeGeocode {
  id                          String   @id @default(cuid())
  normalizedPostcode          String   @unique @map("normalized_postcode")
  displayPostcode             String   @map("display_postcode")
  normalizedPostcodeEncrypted Json?    @map("normalized_postcode_encrypted")
  displayPostcodeEncrypted    Json?    @map("display_postcode_encrypted")
  latitude                    Decimal  @db.Decimal(10, 7)
  longitude                   Decimal  @db.Decimal(10, 7)
  provider                    String
  providerPlaceId             String?  @map("provider_place_id")
  quality                     Json     @default("{}")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  pickupRoutes   RouteDistance[] @relation("PickupGeocode")
  deliveryRoutes RouteDistance[] @relation("DeliveryGeocode")

  @@map("postcode_geocodes")
}

model RouteDistance {
  id                        String   @id @default(cuid())
  organizationId            String   @map("organization_id")
  pickupPostcode            String   @map("pickup_postcode")
  deliveryPostcode          String   @map("delivery_postcode")
  pickupPostcodeEncrypted   Json?    @map("pickup_postcode_encrypted")
  deliveryPostcodeEncrypted Json?    @map("delivery_postcode_encrypted")
  pickupGeocodeId           String   @map("pickup_geocode_id")
  deliveryGeocodeId         String   @map("delivery_geocode_id")
  distanceKm                Decimal  @map("distance_km") @db.Decimal(18, 4)
  durationSeconds           Int?     @map("duration_seconds")
  provider                  String
  providerRouteId           String?  @map("provider_route_id")
  routeHash                 String   @unique @map("route_hash")
  calculationMethod         String   @map("calculation_method")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pickupGeocode   PostcodeGeocode  @relation("PickupGeocode", fields: [pickupGeocodeId], references: [id])
  deliveryGeocode PostcodeGeocode  @relation("DeliveryGeocode", fields: [deliveryGeocodeId], references: [id])
  activityRecords ActivityRecord[]

  @@index([organizationId, pickupPostcode, deliveryPostcode])
  @@map("route_distances")
}

model EvidenceFile {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  filename         String
  mimeType         String   @map("mime_type")
  byteSize         Int      @map("byte_size")
  storageKey       String   @map("storage_key")
  checksum         String
  uploadedByUserId String   @map("uploaded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  organization       Organization             @relation(fields: [organizationId], references: [id])
  uploadedBy         User                     @relation(fields: [uploadedByUserId], references: [id])
  recordEvidence     ActivityRecordEvidence[]
  batchEvidence      ImportBatchEvidence[]
  submissionFiles    FieldSubmissionFile[]
  socialValueRecords SocialValueRecord[]      @relation("SocialValueEvidence")
  classifications    EvidenceClassification[]
  ocrCorrections     OcrCorrection[]

  @@index([organizationId])
  @@map("evidence_files")
}

model ActivityRecordEvidence {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  activityRecordId String   @map("activity_record_id")
  evidenceFileId   String   @map("evidence_file_id")
  createdAt        DateTime @default(now()) @map("created_at")

  activityRecord ActivityRecord @relation(fields: [activityRecordId], references: [id], onDelete: Cascade)
  evidenceFile   EvidenceFile   @relation(fields: [evidenceFileId], references: [id])

  @@unique([activityRecordId, evidenceFileId])
  @@map("activity_record_evidence")
}

model ImportBatchEvidence {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  importBatchId  String   @map("import_batch_id")
  evidenceFileId String   @map("evidence_file_id")
  createdAt      DateTime @default(now()) @map("created_at")

  importBatch  ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  evidenceFile EvidenceFile @relation(fields: [evidenceFileId], references: [id])

  @@unique([importBatchId, evidenceFileId])
  @@map("import_batch_evidence")
}

// ─── Field Submissions (Flutter field workers) ────────────────────────────────

enum FieldSubmissionStatus {
  pending
  submitted
  under_review
  approved
  rejected
  needs_info

  @@map("field_submission_status")
}

enum FieldDocumentType {
  waste_ticket
  delivery_note
  fuel_receipt
  other

  @@map("field_document_type")
}

model FieldSubmission {
  id                        String                @id @default(cuid())
  organizationId            String                @map("organization_id")
  reportingPeriodId         String                @map("reporting_period_id")
  emissionCategoryId        String?               @map("emission_category_id")
  facilityId                String?               @map("facility_id")
  submittedByUserId         String                @map("submitted_by_user_id")
  documentType              FieldDocumentType     @map("document_type")
  status                    FieldSubmissionStatus @default(pending)
  ocrExtractedData          Json?                 @map("ocr_extracted_data")
  formData                  Json                  @map("form_data")
  gpsLat                    Decimal?              @map("gps_lat") @db.Decimal(10, 7)
  gpsLng                    Decimal?              @map("gps_lng") @db.Decimal(10, 7)
  pickupPostcode            String?               @map("pickup_postcode")
  deliveryPostcode          String?               @map("delivery_postcode")
  pickupPostcodeEncrypted   Json?                 @map("pickup_postcode_encrypted")
  deliveryPostcodeEncrypted Json?                 @map("delivery_postcode_encrypted")
  pickupLat                 Decimal?              @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng                 Decimal?              @map("pickup_lng") @db.Decimal(10, 7)
  deliveryLat               Decimal?              @map("delivery_lat") @db.Decimal(10, 7)
  deliveryLng               Decimal?              @map("delivery_lng") @db.Decimal(10, 7)
  calculatedDistanceKm      Decimal?              @map("calculated_distance_km") @db.Decimal(18, 4)
  distanceSource            String?               @map("distance_source")
  // Postcode pipeline — server-side validation and OCR correction results
  postcodeValidationStatus  String?               @map("postcode_validation_status")
  deliveryPostcodeOriginal  String?               @map("delivery_postcode_original")
  postcodeExtractionSource  String?               @map("postcode_extraction_source")
  reviewNote                String?               @map("review_note")
  reviewedByUserId          String?               @map("reviewed_by_user_id")
  reviewedAt                DateTime?             @map("reviewed_at")
  activityRecordId          String?               @map("activity_record_id")
  resubmittedFromId         String?               @map("resubmitted_from_id")
  siteId                    String?               @map("site_id")
  contractId                String?               @map("contract_id")
  deviceSubmittedAt         DateTime?             @map("device_submitted_at")
  requestedByDeadline       DateTime?             @map("requested_by_deadline")
  submittedAt               DateTime?             @map("submitted_at")
  idempotencyKey            String?               @map("idempotency_key")
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")

  organization     Organization          @relation(fields: [organizationId], references: [id])
  reportingPeriod  ReportingPeriod       @relation(fields: [reportingPeriodId], references: [id])
  emissionCategory EmissionCategory?     @relation(fields: [emissionCategoryId], references: [id])
  facility         Facility?             @relation(fields: [facilityId], references: [id])
  site             Site?                 @relation("FieldSubmissionSite", fields: [siteId], references: [id], onDelete: SetNull)
  contract         Contract?             @relation("FieldSubmissionContracts", fields: [contractId], references: [id], onDelete: SetNull)
  submittedBy      User                  @relation(fields: [submittedByUserId], references: [id])
  resubmittedFrom  FieldSubmission?      @relation("FieldSubmissionResubmit", fields: [resubmittedFromId], references: [id])
  resubmissions    FieldSubmission[]     @relation("FieldSubmissionResubmit")
  files            FieldSubmissionFile[]

  @@unique([organizationId, submittedByUserId, idempotencyKey], map: "field_submission_idempotency_key")
  @@index([organizationId, status, createdAt])
  @@index([organizationId, submittedByUserId])
  @@index([organizationId, requestedByDeadline, submittedAt])
  @@map("field_submissions")
}

model FieldSubmissionFile {
  id                String   @id @default(cuid())
  fieldSubmissionId String   @map("field_submission_id")
  evidenceFileId    String   @map("evidence_file_id")
  createdAt         DateTime @default(now()) @map("created_at")

  fieldSubmission FieldSubmission @relation(fields: [fieldSubmissionId], references: [id], onDelete: Cascade)
  evidenceFile    EvidenceFile    @relation(fields: [evidenceFileId], references: [id])

  @@unique([fieldSubmissionId, evidenceFileId])
  @@map("field_submission_files")
}

// ─── Supplier Performance ────────────────────────────────────────────────────

model SupplierPerformance {
  id                   String   @id @default(cuid())
  organizationId       String   @map("organization_id")
  supplierId           String   @map("supplier_id") // References Organization.id (external supplier org)
  submissionCount      Int      @default(0) @map("submission_count")
  approvedCount        Int      @default(0) @map("approved_count")
  rejectedCount        Int      @default(0) @map("rejected_count")
  onTimeCount          Int      @default(0) @map("on_time_count")
  completenessScore    Decimal? @map("completeness_score") @db.Decimal(5, 2)
  dataQualityScore     Decimal? @map("data_quality_score") @db.Decimal(5, 2)
  lastDataQualityTrend String?  @map("last_data_quality_trend") // "improving", "stable", "declining"
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdAt            DateTime @default(now()) @map("created_at")

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade, name: "supplierPerformanceOrg")
  supplier     Organization                 @relation(fields: [supplierId], references: [id], onDelete: Cascade, name: "supplierPerformanceSupplier")
  history      SupplierPerformanceHistory[]

  @@unique([organizationId, supplierId])
  @@index([organizationId])
  @@index([organizationId, supplierId])
  @@index([dataQualityScore(sort: Desc)])
  @@index([submissionCount(sort: Desc)])
  @@map("supplier_performance")
}

model SupplierPerformanceHistory {
  id                    String   @id @default(cuid())
  supplierPerformanceId String   @map("supplier_performance_id")
  organizationId        String   @map("organization_id")
  completenessScore     Decimal  @map("completeness_score") @db.Decimal(5, 2)
  dataQualityScore      Decimal  @map("data_quality_score") @db.Decimal(5, 2)
  submissionCount       Int      @map("submission_count")
  approvedCount         Int      @map("approved_count")
  recordedAt            DateTime @default(now()) @map("recorded_at")

  supplierPerformance SupplierPerformance @relation(fields: [supplierPerformanceId], references: [id], onDelete: Cascade)
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade, name: "supplierPerformanceHistoryOrg")

  @@index([supplierPerformanceId, recordedAt(sort: Desc)])
  @@index([organizationId, recordedAt(sort: Desc)])
  @@map("supplier_performance_history")
}

// ─── Emission Factors ─────────────────────────────────────────────────────────

model FactorLibrary {
  id          String   @id @default(cuid())
  name        String
  version     String
  license     String
  sourceUrl   String?  @map("source_url")
  publishedAt DateTime @map("published_at") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  factors         EmissionFactor[]
  calculationRuns CalculationRun[]

  @@unique([name, version])
  @@map("factor_libraries")
}

model EmissionFactor {
  id                 String    @id @default(cuid())
  factorLibraryId    String    @map("factor_library_id")
  externalId         String?   @map("external_id")
  scope              Int
  emissionCategoryId String?   @map("emission_category_id")
  activityType       String?   @map("activity_type")
  geographyCountry   String?   @map("geography_country")
  geographyRegion    String?   @map("geography_region")
  effectiveStartDate DateTime? @map("effective_start_date") @db.Date
  effectiveEndDate   DateTime? @map("effective_end_date") @db.Date
  inputUnit          String    @map("input_unit")
  co2                Decimal?  @db.Decimal(18, 8)
  ch4                Decimal?  @db.Decimal(18, 8)
  n2o                Decimal?  @db.Decimal(18, 8)
  co2e               Decimal?  @db.Decimal(18, 8)
  uncertaintyRating  String?   @map("uncertainty_rating")
  usageNotes         String?   @map("usage_notes")

  factorLibrary    FactorLibrary         @relation(fields: [factorLibraryId], references: [id])
  emissionCategory EmissionCategory?     @relation(fields: [emissionCategoryId], references: [id])
  calculations     EmissionCalculation[]

  @@index([scope, emissionCategoryId, geographyCountry, effectiveStartDate, effectiveEndDate])
  @@map("emission_factors")
}

// ─── Calculations & Snapshots ─────────────────────────────────────────────────

enum SnapshotVerificationStatus {
  pending_review
  approved
  changes_requested

  @@map("snapshot_verification_status")
}

enum CalculationRunStatus {
  queued
  running
  succeeded
  failed

  @@map("calculation_run_status")
}

model CalculationRun {
  id                   String               @id @default(cuid())
  organizationId       String               @map("organization_id")
  reportingPeriodId    String               @map("reporting_period_id")
  methodologyVersionId String               @map("methodology_version_id")
  factorLibraryId      String               @map("factor_library_id")
  triggeredByUserId    String               @map("triggered_by_user_id")
  status               CalculationRunStatus @default(queued)
  triggerHash          String?              @unique @map("trigger_hash")
  startedAt            DateTime?            @map("started_at")
  finishedAt           DateTime?            @map("finished_at")
  /// Human-readable failure reason — surfaced on the calculations pages.
  errorMessage         String?              @map("error_message")
  createdAt            DateTime             @default(now()) @map("created_at")

  organization       Organization          @relation(fields: [organizationId], references: [id])
  reportingPeriod    ReportingPeriod       @relation(fields: [reportingPeriodId], references: [id])
  methodologyVersion MethodologyVersion    @relation(fields: [methodologyVersionId], references: [id])
  factorLibrary      FactorLibrary         @relation(fields: [factorLibraryId], references: [id])
  triggeredBy        User                  @relation(fields: [triggeredByUserId], references: [id])
  calculations       EmissionCalculation[]
  snapshots          PublishedSnapshot[]
  scenarioRuns       ScenarioRun[]
  dbtRuns            DbtRun[]              @relation("DbtRuns")

  @@index([organizationId, reportingPeriodId, status])
  @@map("calculation_runs")
}

// Immutable — never update rows in this table
model EmissionCalculation {
  id                      String   @id @default(cuid())
  organizationId          String   @map("organization_id")
  activityRecordId        String   @map("activity_record_id")
  calculationRunId        String   @map("calculation_run_id")
  /// Null when no matching factor existed — the record is included with
  /// totalCo2e 0 and a warning instead of failing the whole run.
  emissionFactorId        String?  @map("emission_factor_id")
  factorLibraryId         String   @map("factor_library_id")
  factorLibraryVersion    String   @map("factor_library_version")
  methodologyVersionName  String   @map("methodology_version_name")
  originalAmount          Decimal  @map("original_amount") @db.Decimal(18, 6)
  originalUnit            String   @map("original_unit")
  normalizedAmount        Decimal  @map("normalized_amount") @db.Decimal(18, 6)
  normalizedUnit          String   @map("normalized_unit")
  co2                     Decimal? @db.Decimal(18, 8)
  ch4                     Decimal? @db.Decimal(18, 8)
  n2o                     Decimal? @db.Decimal(18, 8)
  biogenicCo2e            Decimal? @map("biogenic_co2e") @db.Decimal(18, 8)
  totalCo2e               Decimal  @map("total_co2e") @db.Decimal(18, 8)
  selectionReason         String?  @map("selection_reason")
  factorValue             Decimal? @map("factor_value") @db.Decimal(18, 8)
  formula                 String
  warnings                Json     @default("[]")
  dataQualityScore        Int      @default(50) @map("data_quality_score")
  confidenceIntervalLower Decimal? @map("confidence_interval_lower") @db.Decimal(18, 8)
  confidenceIntervalUpper Decimal? @map("confidence_interval_upper") @db.Decimal(18, 8)
  createdAt               DateTime @default(now()) @map("created_at")

  activityRecord     ActivityRecord     @relation(fields: [activityRecordId], references: [id])
  calculationRun     CalculationRun     @relation(fields: [calculationRunId], references: [id])
  emissionFactor     EmissionFactor?    @relation(fields: [emissionFactorId], references: [id])
  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionName], references: [name])
  modelExplanations  ModelExplanation[]  @relation("explanationCalc")

  @@index([calculationRunId])
  @@index([activityRecordId])
  @@map("emission_calculations")
}

model PublishedSnapshot {
  id                 String                     @id @default(cuid())
  organizationId     String                     @map("organization_id")
  reportingPeriodId  String                     @map("reporting_period_id")
  calculationRunId   String                     @map("calculation_run_id")
  publishedByUserId  String                     @map("published_by_user_id")
  publishedAt        DateTime                   @default(now()) @map("published_at")
  version            Int                        @default(1)
  verificationStatus SnapshotVerificationStatus @default(pending_review) @map("verification_status")
  verifiedByUserId   String?                    @map("verified_by_user_id")
  verifiedAt         DateTime?                  @map("verified_at")

  organization    Organization         @relation(fields: [organizationId], references: [id])
  reportingPeriod ReportingPeriod      @relation(fields: [reportingPeriodId], references: [id])
  calculationRun  CalculationRun       @relation(fields: [calculationRunId], references: [id])
  publishedBy     User                 @relation(fields: [publishedByUserId], references: [id])
  verifiedBy      User?                @relation("SnapshotVerifiedBy", fields: [verifiedByUserId], references: [id])
  aggregates      DashboardAggregate[]
  reports         Report[]
  assurance       SnapshotAssurance?
  restatementsSuperseding Restatement[] @relation("RestatementSuperseded")
  restatementsReplacing   Restatement[] @relation("RestatementReplacement")

  @@index([organizationId, reportingPeriodId])
  @@index([organizationId, verificationStatus])
  @@map("published_snapshots")
}

// ─── Auditor Assurance & Sign-Off ─────────────────────────────────────────────

model SnapshotAssurance {
  id              String          @id @default(cuid())
  organizationId  String          @map("organization_id")
  snapshotId      String          @unique @map("snapshot_id")
  auditorUserId   String          @map("auditor_user_id")
  status          AssuranceStatus @default(pending) // pending | approved | rejected
  notes           String?
  signatureBase64 String?         @map("signature_base64") // Optional e-signature data
  signedAt        DateTime?       @map("signed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id])
  snapshot     PublishedSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  auditor      User              @relation("SnapshotAuditor", fields: [auditorUserId], references: [id])

  @@index([organizationId, status])
  @@index([auditorUserId, status])
  @@map("snapshot_assurances")
}

enum AssuranceStatus {
  pending
  approved
  rejected

  @@map("assurance_status")
}

// ─── Scenario / What-If Modeling ──────────────────────────────────────────────
// Ephemeral calculation runs with hypothetical data modifications.
// Never persist to committed EmissionCalculation — only to ScenarioDraft for preview.

model ScenarioRun {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
