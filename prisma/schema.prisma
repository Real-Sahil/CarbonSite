// ─── PHASE 2: Custom Emission Factors, Anomaly Detection, Zapier Integration

model OrganizationEmissionFactor {
  id                 String    @id @default(cuid())
  organizationId     String    @map("organization_id")
  scope              Int
  emissionCategoryId String?   @map("emission_category_id")
  activityType       String?   @map("activity_type")
  geographyCountry   String?   @map("geography_country")
  geographyRegion    String?   @map("geography_region")
  effectiveStartDate DateTime? @map("effective_start_date") @db.Date
  effectiveEndDate   DateTime? @map("effective_end_date") @db.Date
  inputUnit          String    @map("input_unit")
  co2                Decimal?  @db.Decimal(18, 8)
  ch4                Decimal?  @db.Decimal(18, 8)
  n2o                Decimal?  @db.Decimal(18, 8)
  co2e               Decimal?  @db.Decimal(18, 8)
  uncertaintyRating  String?   @map("uncertainty_rating")
  usageNotes         String?   @map("usage_notes")
  source             String // e.g., "uploaded_csv", "admin_manual"
  version            Int       @default(1) // For versioning org-specific factors
  createdByUserId    String    @map("created_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emissionCategory EmissionCategory? @relation(fields: [emissionCategoryId], references: [id])
  createdBy        User              @relation("CustomFactorCreator", fields: [createdByUserId], references: [id])

  @@unique([organizationId, scope, emissionCategoryId, activityType, geographyCountry, geographyRegion, inputUnit, version])
  @@index([organizationId, scope, emissionCategoryId])
  @@index([organizationId, effectiveStartDate, effectiveEndDate])
  @@map("organization_emission_factors")
}

model SupplierAnomaly {
  id                    String    @id @default(cuid())
  organizationId        String    @map("organization_id")
  supplierDataRequestId String    @map("supplier_data_request_id")
  anomalyScore          Decimal   @map("anomaly_score") @db.Decimal(5, 4) // 0.0-1.0
  anomalySeverity       String    @map("anomaly_severity") // "warning", "critical"
  reason                String // Human-readable explanation
  flaggedFields         Json      @map("flagged_fields") // Array of { field, value, expectedRange }
  historicalAverage     Decimal?  @map("historical_average") @db.Decimal(18, 8)
  historicalStdDev      Decimal?  @map("historical_std_dev") @db.Decimal(18, 8)
  detectedAt            DateTime  @default(now()) @map("detected_at")
  acknowledgedAt        DateTime? @map("acknowledged_at")
  acknowledgedByUserId  String?   @map("acknowledged_by_user_id")
  acknowledgedNote      String?   @map("acknowledged_note")
  createdAt             DateTime  @default(now()) @map("created_at")

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierDataRequest SupplierDataRequest @relation(fields: [supplierDataRequestId], references: [id], onDelete: Cascade)
  acknowledgedBy      User?               @relation("AnomalyAcknowledger", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, anomalySeverity])
  @@index([organizationId, detectedAt])
  @@index([supplierDataRequestId])
  @@map("supplier_anomalies")
}

model ZapierIntegration {
