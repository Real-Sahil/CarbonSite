  @@map("airbyte_sync_connections")
}

// ─── Phase 3A: Scope 3 Estimation via ML ────────────────────────────────────

model Scope3EstimationModel {
  id                    String    @id @default(cuid())
  organizationId        String    @map("organization_id")
  emissionCategoryId    String    @map("emission_category_id")
  facilityType          String?   @map("facility_type") // e.g., "manufacturing", "office", "warehouse"
  modelType             String    @default("linear-regression") @map("model_type") // "linear-regression", "random-forest"
  trainingRecordCount   Int       @map("training_record_count")
  coefficients          Json // Model parameters: { intercept, features: {featureName: coefficient} }
  modelMetrics          Json // R², RMSE, MAE, etc.
  featureImportance     Json // Feature importance scores
  trainingDataDateRange Json // { from: Date, to: Date }
  confidenceThreshold   Decimal   @default("0.7") @map("confidence_threshold") @db.Decimal(3, 2)
  lastTrainedAt         DateTime  @map("last_trained_at")
  nextTrainAt           DateTime? @map("next_train_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization     Organization     @relation("EstimationModels", fields: [organizationId], references: [id], onDelete: Cascade)
  emissionCategory EmissionCategory @relation("EstimationModels", fields: [emissionCategoryId], references: [id])
  estimates        Scope3Estimate[] @relation("ModelEstimates")

  @@unique([organizationId, emissionCategoryId, facilityType])
  @@index([organizationId, lastTrainedAt])
  @@map("scope3_estimation_models")
}

model Scope3Estimate {
  id                    String    @id @default(cuid())
  organizationId        String    @map("organization_id")
  facilitId             String?   @map("facility_id") // Optional reference to facility
  emissionCategoryId    String    @map("emission_category_id")
  estimationModelId     String    @map("estimation_model_id")
  estimatedValue        Decimal   @map("estimated_value") @db.Decimal(18, 6)
  estimatedUnit         String    @map("estimated_unit") // e.g., "tonnes", "kwh"
  confidenceScore       Decimal   @map("confidence_score") @db.Decimal(3, 2) // 0-1
  confidenceInterval    Json // { lower: number, upper: number, percentile: 95 }
  modelInputs           Json // Features used for prediction
  predictionExplanation String?   @map("prediction_explanation") // Why this estimate?
  basedOnRecordCount    Int       @default(0) @map("based_on_record_count")
  status                String    @default("pending") @map("status") // "pending", "accepted", "rejected", "used"
  acceptedAt            DateTime? @map("accepted_at")
  acceptedByUserId      String?   @map("accepted_by_user_id")
  rejectionReason       String?   @map("rejection_reason")
  activityRecordId      String?   @map("activity_record_id") // If linked to actual record
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization     Organization          @relation("Scope3Estimates", fields: [organizationId], references: [id], onDelete: Cascade)
  emissionCategory EmissionCategory      @relation("Scope3Estimates", fields: [emissionCategoryId], references: [id])
  estimationModel  Scope3EstimationModel @relation("ModelEstimates", fields: [estimationModelId], references: [id], onDelete: Restrict)
  acceptedBy       User?                 @relation("Scope3EstimatesAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  activityRecord   ActivityRecord?       @relation("ActivityRecordEstimate", fields: [activityRecordId], references: [id], onDelete: SetNull)

  @@index([organizationId, emissionCategoryId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([estimationModelId])
  @@map("scope3_estimates")
}

// ─── Invoice & Spend Tracking (Scope 3 Foundation) ──────────────────────────

model InvoiceRecord {
  id                String                  @id @default(cuid())
  organizationId    String                  @map("organization_id")
  externalInvoiceId String                  @map("external_invoice_id") // Vendor's invoice ID
  sourceSystem      String                  @map("source_system") // 'xero', 'sap', 'quickbooks', 'manual'
  vendorId          String                  @map("vendor_id")
  vendorName        String                  @map("vendor_name")
  invoiceDate       DateTime                @map("invoice_date")
  receivedDate      DateTime?               @map("received_date") // Goods receipt date
  dueDate           DateTime?               @map("due_date")
  totalAmount       Decimal                 @map("total_amount") @db.Decimal(15, 2)
  lineItems         Json                    @map("line_items") // [{itemId, qty, unitPrice, receivedQty?, description}]
  paymentStatus     String                  @default("unpaid") @map("payment_status") // 'paid', 'unpaid', 'partial'
  notes             String?
  scope3ReadyStatus String                  @default("pending") @map("scope3_ready_status") // 'pending', 'approved', 'rejected', 'excluded'
  extractedAt       DateTime                @map("extracted_at")
  processedAt       DateTime?               @map("processed_at")
  anomalies         InvoiceAnomaly[]
  reconciliations   InvoiceReconciliation[]
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  organization Organization @relation("InvoiceRecords", fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceSystem, externalInvoiceId])
  @@index([organizationId, invoiceDate(sort: Desc)])
  @@index([organizationId, scope3ReadyStatus])
  @@index([organizationId, vendorId])
  @@map("invoice_records")
}

model InvoiceAnomaly {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  invoiceId      String    @map("invoice_id")
  anomalyType    String    @map("anomaly_type") // 'duplicate', 'qty_mismatch', 'price_spike', 'date_inconsistency', 'missing_grn', 'over_billing', 'orphaned', 'duplicate_line'
  severity       String    @map("severity") // 'info', 'warning', 'critical'
  reason         String    @map("reason") // Human-readable explanation
  detectedAt     DateTime  @default(now()) @map("detected_at")
  resolution     String?   @map("resolution") // 'approved', 'rejected', 'pending'
  resolvedBy     String?   @map("resolved_by")
  resolvedAt     DateTime? @map("resolved_at")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization  @relation("InvoiceAnomalies", fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        InvoiceRecord @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  resolvedByUser User?         @relation("InvoiceAnomalyResolutions", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([invoiceId, severity])
  @@index([organizationId, resolution, detectedAt(sort: Desc)])
  @@index([organizationId, anomalyType])
  @@map("invoice_anomalies")
}

model InvoiceReconciliation {
  id                 String   @id @default(cuid())
  organizationId     String   @map("organization_id")
  invoiceId          String   @map("invoice_id")
  lineItemId         String   @map("line_item_id")
  quantityOrdered    Int      @map("quantity_ordered")
  quantityReceived   Int      @map("quantity_received")
  quantityInvoiced   Int      @map("quantity_invoiced")
  unitPrice          Decimal  @map("unit_price") @db.Decimal(15, 4)
  matchStatus        String   @map("match_status") // 'matched', 'over_received', 'under_received', 'unreconciled'
  discrepancyPercent Decimal? @map("discrepancy_percent") @db.Decimal(5, 2) // |(invoiced - received) / received| * 100
  createdAt          DateTime @default(now()) @map("created_at")

  invoice      InvoiceRecord  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization   @relation("InvoiceReconciliations", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([organizationId, matchStatus])
  @@map("invoice_reconciliations")
}

// ─── Audit & Compliance ──────────────────────────────────────────────────────

model AuditContext {
