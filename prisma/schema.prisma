  failuresCount  Int       @default(0) @map("failures_count")
  failureSamples Json?     @map("failure_samples")
  qualityScore   Decimal?  @map("quality_score") @db.Decimal(5, 2)
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importBatch  ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([organizationId, importBatchId])
  @@index([organizationId, checkType])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("data_quality_checks")
}

model ImportBatchQualityScore {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  importBatchId    String    @unique @map("import_batch_id") @db.Uuid
  overallScore     Decimal   @map("overall_score") @db.Decimal(5, 2)
  checksPassed     Int       @map("checks_passed")
  checksTotal      Int       @map("checks_total")
  canCommit        Boolean   @map("can_commit")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importBatch  ImportBatch   @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("import_batch_quality_scores")
}

// ─── Phase 1A: pgAudit Database-Level Audit Trail ────────────────────────────

model AuditEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  actorId        String?   @map("actor_id")
  action         String
  tableName      String    @map("table_name")
  recordId       String?   @map("record_id")
  oldValues      Json?     @map("old_values")
  newValues      Json?     @map("new_values")
  timestamp      DateTime  @default(now())
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, timestamp(sort: Desc)])
  @@index([organizationId, action])
  @@index([organizationId, tableName])
  @@index([organizationId, tableName, recordId])
  @@map("audit_events")
}

// ─── Phase 2A: Airbyte Data Integration ──────────────────────────────────────

model StagedExternalData {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  sourceSystem      String    @map("source_system") // 'salesforce', 'sap', 'aws_iot', etc.
  sourceRecordId    String    @map("source_record_id")
  dataType          String    @map("data_type") // 'facility_spend', 'material_cost', 'energy_consumption'
  payload           Json
  extractedAt       DateTime  @map("extracted_at")
  processed         Boolean   @default(false)
  processedAt       DateTime? @map("processed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceSystem, sourceRecordId])
  @@index([organizationId, sourceSystem, processed])
  @@index([organizationId, dataType, processed])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("staged_external_data")
}

model AirbyteSyncConnection {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  sourceSystem        String    @map("source_system") // 'salesforce', 'sap', 'aws_iot'
  airbytConnectionId  String?   @map("airbyte_connection_id")
  airbytSourceId      String?   @map("airbyte_source_id")
  airbytDestinationId String?   @map("airbyte_destination_id")
  config              Json      // Connection-specific configuration (credentials, mappings, etc.)
  enabled             Boolean   @default(true)
  lastSyncAt          DateTime? @map("last_sync_at")
  lastSyncStatus      String?   @map("last_sync_status") // 'success', 'failed', 'partial'
  syncFrequency       String    @default("daily") @map("sync_frequency") // 'daily', 'weekly', 'manual'
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sourceSystem, enabled])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("airbyte_sync_connections")
}

// ─── Phase 3A: Scope 3 Estimation via ML ────────────────────────────────────

model Scope3EstimationModel {
  id                    String    @id @default(cuid())
  organizationId        String    @map("organization_id")
  emissionCategoryId    String    @map("emission_category_id")
  facilityType          String?   @map("facility_type") // e.g., "manufacturing", "office", "warehouse"
  modelType             String    @default("linear-regression") @map("model_type") // "linear-regression", "random-forest"
  trainingRecordCount   Int       @map("training_record_count")
  coefficients          Json      // Model parameters: { intercept, features: {featureName: coefficient} }
  modelMetrics          Json      // R², RMSE, MAE, etc.
  featureImportance     Json      // Feature importance scores
  trainingDataDateRange Json      // { from: Date, to: Date }
  confidenceThreshold   Decimal   @default("0.7") @map("confidence_threshold") @db.Decimal(3, 2)
  lastTrainedAt         DateTime  @map("last_trained_at")
  nextTrainAt           DateTime? @map("next_train_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization       Organization           @relation("EstimationModels", fields: [organizationId], references: [id], onDelete: Cascade)
  emissionCategory   EmissionCategory       @relation("EstimationModels", fields: [emissionCategoryId], references: [id])
  estimates          Scope3Estimate[]       @relation("ModelEstimates")

  @@unique([organizationId, emissionCategoryId, facilityType])
  @@index([organizationId, lastTrainedAt])
  @@map("scope3_estimation_models")
}

model Scope3Estimate {
  id                     String    @id @default(cuid())
  organizationId         String    @map("organization_id")
  facilitId              String?   @map("facility_id") // Optional reference to facility
  emissionCategoryId     String    @map("emission_category_id")
  estimationModelId      String    @map("estimation_model_id")
  estimatedValue         Decimal   @map("estimated_value") @db.Decimal(18, 6)
  estimatedUnit          String    @map("estimated_unit") // e.g., "tonnes", "kwh"
  confidenceScore        Decimal   @map("confidence_score") @db.Decimal(3, 2) // 0-1
  confidenceInterval     Json      // { lower: number, upper: number, percentile: 95 }
  modelInputs            Json      // Features used for prediction
  predictionExplanation String?   @map("prediction_explanation") // Why this estimate?
  basedOnRecordCount     Int       @default(0) @map("based_on_record_count")
  status                 String    @default("pending") @map("status") // "pending", "accepted", "rejected", "used"
  acceptedAt             DateTime? @map("accepted_at")
  acceptedByUserId       String?   @map("accepted_by_user_id")
  rejectionReason        String?   @map("rejection_reason")
  activityRecordId       String?   @map("activity_record_id") // If linked to actual record
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization       Organization           @relation("Scope3Estimates", fields: [organizationId], references: [id], onDelete: Cascade)
  emissionCategory   EmissionCategory       @relation("Scope3Estimates", fields: [emissionCategoryId], references: [id])
  estimationModel    Scope3EstimationModel  @relation("ModelEstimates", fields: [estimationModelId], references: [id], onDelete: Restrict)
  acceptedBy         User?                  @relation("Scope3EstimatesAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  activityRecord     ActivityRecord?        @relation("ActivityRecordEstimate", fields: [activityRecordId], references: [id], onDelete: SetNull)

  @@index([organizationId, emissionCategoryId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([estimationModelId])
  @@map("scope3_estimates")
}

// ─── Audit & Compliance ──────────────────────────────────────────────────────

model AuditContext {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  auditLogId      String   @map("audit_log_id")
  framework       String   // 'csrd', 'sbti', 'cdp', 'ghg-protocol', 'iso-14064'
  resourceType    String   @map("resource_type") // 'emission_calculation', 'activity_record', 'snapshot', 'report'
  resourceId      String   @map("resource_id")
  contextMetadata Json?    @map("context_metadata") // Framework-specific metadata
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation("AuditContexts", fields: [organizationId], references: [id], onDelete: Cascade)
  auditLog     AuditLog     @relation("AuditContexts", fields: [auditLogId], references: [id], onDelete: Cascade)

  @@index([organizationId, framework, resourceType, resourceId])
  @@index([organizationId, auditLogId])
  @@map("audit_contexts")
}

// ─── SSO & Enterprise Auth ───────────────────────────────────────────────────

model SsoConfiguration {
  id                String   @id @default(cuid())
  organizationId    String   @unique @map("organization_id")
  provider          String   // 'okta', 'azure_ad', 'google_workspace', 'generic_oidc', 'saml'
  enabled           Boolean  @default(true)
  metadataUrl       String?  @map("metadata_url")
  clientId          String   @map("client_id")
  clientSecret      String   @map("client_secret") // Encrypted in transit
  idpEntityId       String?  @map("idp_entity_id") // For SAML
  ssoUrl            String?  @map("sso_url") // For SAML
  certificateX509   String?  @map("certificate_x509") // For SAML validation
  autoCreateUsers   Boolean  @default(true) @map("auto_create_users")
  autoAssignRole    String?  @default("viewer") @map("auto_assign_role") // admin | editor | reviewer | viewer | field_worker
  requireMfa        Boolean  @default(false) @map("require_mfa")
  syncAttributes    Json?    @map("sync_attributes") // Maps IdP claims to user fields
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization @relation("SsoConfigurations", fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("sso_configurations")
}

model SsoSession {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  userId          String   @map("user_id")
  provider        String
  providerUserId  String   @map("provider_user_id")
  idpSessionId    String?  @map("idp_session_id") // To track sessions at IdP level
  accessToken     String?  @map("access_token")
  refreshToken    String?  @map("refresh_token")
  tokenExpiresAt  DateTime? @map("token_expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  lastActivityAt  DateTime @default(now()) @updatedAt @map("last_activity_at")

  organization Organization @relation("SsoSessions", fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("SsoSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([organizationId, provider])
  @@unique([organizationId, providerUserId])
  @@map("sso_sessions")
}
