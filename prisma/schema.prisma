// ─── SSO & Enterprise Auth ───────────────────────────────────────────────────

model SsoConfiguration {
  id              String   @id @default(cuid())
  organizationId  String   @unique @map("organization_id")
  provider        String // 'okta', 'azure_ad', 'google_workspace', 'generic_oidc', 'saml'
