// ─── Integration Configuration & Management ──────────────────────────────────

model IntegrationConfig {
  id                           String    @id @default(cuid())
  organizationId               String    @unique @map("organization_id")
  organization                 Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // LLM Configuration
  llmProvider                  String?   @map("llm_provider") // "huggingface" | "nvidia"
  llmToken                     String?   @map("llm_token") // Encrypted
  llmTokenValidatedAt          DateTime? @map("llm_token_validated_at")
  llmTokenValid                Boolean   @default(false) @map("llm_token_valid")

  // Xero OAuth
  xeroClientId                 String?   @map("xero_client_id")
  xeroClientSecret             String?   @map("xero_client_secret") // Encrypted
  xeroConnected                Boolean   @default(false) @map("xero_connected")
  xeroConnectedAt              DateTime? @map("xero_connected_at")
  xeroTenantId                 String?   @map("xero_tenant_id") // From OAuth flow
  xeroRefreshToken             String?   @map("xero_refresh_token") // Encrypted
  xeroTokenExpiresAt           DateTime? @map("xero_token_expires_at")

  // QuickBooks OAuth
  quickbooksClientId           String?   @map("quickbooks_client_id")
  quickbooksClientSecret       String?   @map("quickbooks_client_secret") // Encrypted
  quickbooksConnected          Boolean   @default(false) @map("quickbooks_connected")
  quickbooksConnectedAt        DateTime? @map("quickbooks_connected_at")
  quickbooksRealmId            String?   @map("quickbooks_realm_id") // From OAuth flow
  quickbooksRefreshToken       String?   @map("quickbooks_refresh_token") // Encrypted
  quickbooksTokenExpiresAt     DateTime? @map("quickbooks_token_expires_at")

  // Sage OAuth
  sageClientId                 String?   @map("sage_client_id")
  sageClientSecret             String?   @map("sage_client_secret") // Encrypted
  sageConnected                Boolean   @default(false) @map("sage_connected")
  sageConnectedAt              DateTime? @map("sage_connected_at")
  sageTenantId                 String?   @map("sage_tenant_id") // From OAuth flow
  sageRefreshToken             String?   @map("sage_refresh_token") // Encrypted
  sageTokenExpiresAt           DateTime? @map("sage_token_expires_at")

  // OIDC/SSO Configuration
  oidcProvider                 String?   @map("oidc_provider") // "google" | "okta" | "azure" | "generic"
  oidcClientId                 String?   @map("oidc_client_id")
  oidcClientSecret             String?   @map("oidc_client_secret") // Encrypted
  oidcIssuerUrl                String?   @map("oidc_issuer_url")
  oidcDiscoveryValidatedAt     DateTime? @map("oidc_discovery_validated_at")
  oidcDiscoveryValid           Boolean   @default(false) @map("oidc_discovery_valid")

  // n8n Webhooks
  n8nWebhookReports            String?   @map("n8n_webhook_reports") // Encrypted
  n8nWebhookReportsTested      Boolean   @default(false) @map("n8n_webhook_reports_tested")
  n8nWebhookSubmissions        String?   @map("n8n_webhook_submissions") // Encrypted
  n8nWebhookSubmissionsTested  Boolean   @default(false) @map("n8n_webhook_submissions_tested")

  // Audit & Timestamps
  lastTestedAt                 DateTime? @map("last_tested_at")
  testResults                  Json?     @map("test_results") // { llm: { status, error? }, xero: {...}, oidc: {...}, n8n: {...} }
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("integration_configs")
}

// ─── Phase 3: Data Transformation & Orchestration ──────────────────────────

model N8nWorkflow {
  id                String          @id @default(cuid())
  organizationId    String          @map("organization_id")
  n8nWorkflowId     String          @map("n8n_workflow_id") // ID from n8n instance
  name              String
  description       String?
  trigger           String          @map("trigger") // 'report_ready', 'field_submission', 'import_complete', 'manual'
  action            String          @map("action") // 'send_email', 'slack_notification', 'create_jira_ticket', 'update_spreadsheet'
  enabled           Boolean         @default(true)
  n8nWebhookUrl     String?         @map("n8n_webhook_url") // Encrypted, for CarbonSite → n8n direction
  config            Json // Workflow-specific config (email templates, Slack channels, etc.)
  lastTriggeredAt   DateTime?       @map("last_triggered_at")
  lastTriggeredBy   String?         @map("last_triggered_by") // Event type that triggered it
  failureCount      Int             @default(0) @map("failure_count")
  lastFailedAt      DateTime?       @map("last_failed_at")
  lastFailureReason String?         @map("last_failure_reason")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization Organization       @relation("N8nWorkflows", fields: [organizationId], references: [id], onDelete: Cascade)
  executions       N8nExecution[]

  @@unique([organizationId, n8nWorkflowId])
  @@index([organizationId, trigger, enabled])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("n8n_workflows")
}

model N8nExecution {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  workflowId      String    @map("workflow_id")
  n8nExecutionId  String    @map("n8n_execution_id") // ID from n8n
  triggerEvent    String    @map("trigger_event") // 'report_ready', 'field_submission', etc.
  status          String    @default("running") @map("status") // 'running', 'success', 'error', 'timeout'
  output          Json?     @map("output") // Workflow output data
  errorMessage    String?   @map("error_message")
  duration        Int?      @map("duration") // milliseconds
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization @relation("N8nExecutions", fields: [organizationId], references: [id], onDelete: Cascade)
  workflow         N8nWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([organizationId, workflowId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("n8n_executions")
}

model AirbiteConnector {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  sourceSystem     String    @map("source_system") // 'salesforce', 'sap', 'xero', 'quickbooks', 'stripe', 'slack', 'aws_iot', 'openweather'
  displayName      String    @map("display_name") // User-friendly name
  enabled          Boolean   @default(true)
  syncSchedule     String?   @map("sync_schedule") // 'hourly', 'daily', 'weekly', 'manual'
  config           Json      @map("config") // Source-specific config (API keys, field mappings, etc.)
  recordsSynced    Int       @default(0) @map("records_synced")
  lastSyncAt       DateTime? @map("last_sync_at")
  lastSyncStatus   String?   @map("last_sync_status") // 'success', 'failed', 'partial'
  lastSyncError    String?   @map("last_sync_error")
  nextScheduledAt  DateTime? @map("next_scheduled_at")
  failureCount     Int       @default(0) @map("failure_count")
  lastFailureAt    DateTime? @map("last_failure_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation("AirbiteConnectors", fields: [organizationId], references: [id], onDelete: Cascade)
  syncLogs         AirbyteSyncLog[]

  @@unique([organizationId, sourceSystem])
  @@index([organizationId, enabled])
  @@index([organizationId, lastSyncAt(sort: Desc)])
  @@map("airbite_connectors")
}

model AirbyteSyncLog {
  id           String    @id @default(cuid())
  organizationId String  @map("organization_id")
  connectorId  String    @map("connector_id")
  status       String    @map("status") // 'running', 'success', 'failed'
  recordsRead  Int       @default(0) @map("records_read")
  recordsWritten Int     @default(0) @map("records_written")
  errorMessage String?   @map("error_message")
  duration     Int?      @map("duration") // milliseconds
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  organization Organization @relation("AirbyteSyncLogs", fields: [organizationId], references: [id], onDelete: Cascade)
  connector      AirbiteConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([organizationId, connectorId])
  @@index([connectorId, status, startedAt(sort: Desc)])
  @@map("airbyte_sync_logs")
}

model DbtRun {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  calculationRunId  String    @map("calculation_run_id")
  status            String    @default("queued") @map("status") // 'queued', 'running', 'success', 'failed'
  modelsExecuted    Int?      @map("models_executed")
  testsRun          Int?      @map("tests_run")
  testsPassed       Int?      @map("tests_passed")
  testsFailed       Int?      @map("tests_failed")
  output            String?   @map("output") // stdout/stderr from dbt
  errorMessage      String?   @map("error_message")
  durationSeconds   Int?      @map("duration_seconds")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization   Organization   @relation("DbtRuns", fields: [organizationId], references: [id], onDelete: Cascade)
  calculationRun CalculationRun @relation("DbtRuns", fields: [calculationRunId], references: [id], onDelete: Cascade)

  @@unique([organizationId, calculationRunId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("dbt_runs")
}

model Forecast {
  id                    String    @id @default(cuid())
  organizationId        String    @map("organization_id")
  forecastType          String    @map("forecast_type") // "emissions", "supplier_quality", "anomaly_rate"
  targetPeriodStart     DateTime  @map("target_period_start") // start of forecast period
  targetPeriodEnd       DateTime  @map("target_period_end")   // end of forecast period
  predictions           Json      @map("predictions")         // array of {date, forecast, lowerBound, upperBound, confidence}
  accuracy              Decimal?  @db.Decimal(5, 2)           // MAPE or similar accuracy metric
  modelVersion          String    @map("model_version")       // "exponential_smoothing_v1" etc
  trainingDataPoints    Int       @map("training_data_points")
  method                String    @map("method")              // "exponential_smoothing", "seasonal_decomposition"
  metadata              Json?     @map("metadata")            // method-specific params (alpha, beta, etc)
  generatedAt           DateTime  @default(now()) @map("generated_at")
  validUntil            DateTime  @map("valid_until")         // when forecast becomes stale
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation("Forecasts", fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, forecastType, targetPeriodStart])
  @@index([organizationId, forecastType, generatedAt(sort: Desc)])
  @@index([organizationId, validUntil])
  @@map("forecasts")
}

// Causal Inference Runs — Root cause analysis via DoWhy
// Stores results of causal analysis (facility upgrades, supplier switches, process changes)
model CausalInferenceRun {
  id                            String    @id @default(cuid())
  organizationId                String    @map("organization_id")
  question                      String    // Natural language question (e.g., "What impact did our facility upgrade have?")
  treatment                     String    // Treatment variable (e.g., "upgraded_facility")
  outcome                       String    // Outcome variable (e.g., "emissions_reduction_pct")
  treatmentEffect               Decimal?  @db.Decimal(10, 4) // ATE — Average Treatment Effect
  confidenceIntervalLower       Decimal?  @db.Decimal(10, 4)
  confidenceIntervalUpper       Decimal?  @db.Decimal(10, 4)
  pValue                        Decimal?  @db.Decimal(5, 4) // Statistical significance
  robustnessToUnmeasuredConf    Decimal?  @db.Decimal(3, 2) // 0-1 scale; robustness to hidden confounders
  sampleSize                    Int? // N of matched pairs used in estimation
  method                        String? // "backdoor", "propensity_score", "iv", "sensitivity"
  causalGraph                   Json? // Graph structure and confounders
  modelId                       String? @map("model_id") // Reference to predefined model (facility_upgrade, etc)
  confounders                   Json? // Array of confounder variable names
  resultSummary                 String? @map("result_summary") // Plain-language interpretation
  status                        String @default("completed") // "queued", "processing", "completed", "failed"
  errorMessage                  String? @map("error_message")
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  organization Organization @relation("CausalInferenceRuns", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([organizationId, modelId])
  @@map("causal_inference_runs")
}

// ─── Supplier Reports (Scope 3 anonymous form submissions) ────────────────────

model SupplierReport {
  id                  String    @id @default(cuid())
  organizationId      String    @map("organization_id")
  // Link to the request that generated the token (nullable for future direct submissions)
  supplierDataRequestId String? @map("supplier_data_request_id")
  // Supplier identity (email + name from token; no account required)
  supplierEmail       String    @map("supplier_email")
  supplierName        String?   @map("supplier_name")
  supplierDomain      String?   @map("supplier_domain") // extracted from email for grouping
  // What was reported
  emissionCategoryId  String    @map("emission_category_id")
  reportingYear       Int       @map("reporting_year")
  totalAmount         Decimal   @map("total_amount") @db.Decimal(18, 6)
  unit                String    // e.g. "tCO2e", "kgCO2e", "GBP" (spend-based)
  calculationMethod   String    @map("calculation_method") // "spend_based" | "activity_based" | "direct_measurement"
  // Supporting narrative
  notes               String?
  supportingFileKeys  String[]  @map("supporting_file_keys") // R2 storage keys
  // Quality scoring (run inline on submission)
  qualityScore        Int?      @map("quality_score") // 0-100
  qualityFlags        Json?     @map("quality_flags") // [{type, message, severity}]
  // Review workflow
  status              String    @default("submitted") // submitted | under_review | accepted | rejected
  reviewedByUserId    String?   @map("reviewed_by_user_id")
  reviewedAt          DateTime? @map("reviewed_at")
  rejectionReason     String?   @map("rejection_reason")
  // Conversion tracking
  convertedToRecordId String?   @map("converted_to_record_id") // ActivityRecord.id after acceptance
  convertedAt         DateTime? @map("converted_at")
  // Timestamps
  submittedAt         DateTime  @default(now()) @map("submitted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emissionCategory    EmissionCategory    @relation(fields: [emissionCategoryId], references: [id])
  reviewedBy          User?               @relation("SupplierReportReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, reportingYear])
  @@index([organizationId, supplierEmail])
  @@index([supplierDataRequestId])
  @@map("supplier_reports")
}

// ─── Supplier Analytics (Phase 5A) ──────────────────────────────────────
// Real-time supplier performance scoring, trending, and anomaly detection

model SupplierAnalytic {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  supplierId String @map("supplier_id") // References Organization.id (external supplier org)

  // Performance metrics
  submissionCount Int @default(0) @map("submission_count")
  approvalRate Decimal @db.Decimal(3, 2) @default(0) @map("approval_rate") // 0-1
  completenessScore Decimal @db.Decimal(3, 2) @default(0) @map("completeness_score") // 0-1
  timelinessScore Decimal @db.Decimal(3, 2) @default(0) @map("timeliness_score") // 0-1
  overallScore Decimal @db.Decimal(5, 2) @default(0) @map("overall_score") // 0-100

  // Trending
  trend String @default("stable") @map("trend") // 'improving' | 'stable' | 'declining'
  previousScore Decimal @db.Decimal(5, 2) @map("previous_score")
  scoreChange Decimal @db.Decimal(5, 2) @map("score_change")

  // Forecasting
  forecastedEmissions Decimal @db.Decimal(15, 2) @map("forecasted_emissions") // 12-month total
  forecastConfidence Decimal @db.Decimal(3, 2) @map("forecast_confidence") // 0-1

  // Anomalies
  lastAnomalyDetected DateTime? @map("last_anomaly_detected")
  anomalyCount Int @default(0) @map("anomaly_count")

  // Lifecycle
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, name: "supplierAnalyticOrg")
  supplier Organization @relation(fields: [supplierId], references: [id], onDelete: Cascade, name: "supplierAnalyticSupplier")

  @@unique([organizationId, supplierId])
  @@index([organizationId, overallScore(sort: Desc)])
  @@index([organizationId, trend])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("supplier_analytics")
}

// ─── PHASE 5A: Time-Series Forecasting (Prophet/Exponential Smoothing) ──────

model EmissionsForecast {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  facilityId String? @map("facility_id")
  categoryId String @map("category_id")

  // Training parameters
  trainingPeriodMonths Int @map("training_period_months")
  trainingDataPoints Int @map("training_data_points")

  // Forecast range
  forecastHorizonMonths Int @default(12) @map("forecast_horizon_months")
  forecastStartDate DateTime @map("forecast_start_date")
  forecastEndDate DateTime @map("forecast_end_date")

  // Forecast results: [{date, predicted_value, lower_ci, upper_ci, confidence}]
  forecastData Json @map("forecast_data")
  forecastMethod String @default("exponential_smoothing") @map("forecast_method")

  // Accuracy metrics
  mape Decimal? @db.Decimal(5, 2) // Mean Absolute Percentage Error
  rmse Decimal? @db.Decimal(15, 2) // Root Mean Squared Error
  mae Decimal? @db.Decimal(15, 2) // Mean Absolute Error
  rSquared Decimal? @db.Decimal(3, 2) @map("r_squared")

  // Quality scoring
  modelConfidence Decimal @default(0.5) @db.Decimal(3, 2) @map("model_confidence")
  dataQualityScore Decimal @default(0.5) @db.Decimal(3, 2) @map("data_quality_score")
  anomalyDetectionApplied Boolean @default(false) @map("anomaly_detection_applied")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, name: "forecastOrg")
  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull, name: "forecastFacility")
  category EmissionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, name: "forecastCategory")

  @@unique([organizationId, facilityId, categoryId, forecastStartDate])
  @@index([organizationId, forecastStartDate(sort: Desc)])
  @@index([organizationId, modelConfidence(sort: Desc)])
  @@map("emissions_forecasts")
}

// ─── PHASE 5B: Model Explainability (SHAP-like Feature Importance) ────────────

model ModelExplanation {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  emissionCalculationId String @map("emission_calculation_id")

  // Feature importance: [{feature_name, importance_value, impact_direction, confidence}]
  featureImportance Json @map("feature_importance")

  // Top driver
  topDriverFeature String @map("top_driver_feature")
  topDriverContributionPct Decimal @db.Decimal(5, 2) @map("top_driver_contribution_pct")

  // Prediction breakdown
  baseValue Decimal @db.Decimal(15, 2) @map("base_value")
  predictionValue Decimal @db.Decimal(15, 2) @map("prediction_value")
  predictionDelta Decimal @db.Decimal(15, 2) @map("prediction_delta")

  // Individual contributions
  factorContribution Decimal @db.Decimal(15, 2) @map("factor_contribution")
  activityContribution Decimal @db.Decimal(15, 2) @map("activity_contribution")
  methodologyContribution Decimal @db.Decimal(15, 2) @map("methodology_contribution")

  // Human-readable explanation & what-if scenarios
  explanationText String?
  whatIfScenarios Json? @map("what_if_scenarios") // [{scenario_name, predicted_value, change_pct}]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, name: "explanationOrg")
  calculation EmissionCalculation @relation(fields: [emissionCalculationId], references: [id], onDelete: Cascade, name: "explanationCalc")

  @@unique([emissionCalculationId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("model_explanations")
}

// ─── PHASE 5C: Root Cause Analysis & Causal Inference ────────────────────────

model CausalAnalysis {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  facilityId String? @map("facility_id")

  // Anomaly being analyzed
  anomalyType String @map("anomaly_type") // 'spike' | 'drop' | 'trend_change' | 'unexpected_value'
  anomalyDate DateTime @map("anomaly_date")
  observedValue Decimal @db.Decimal(15, 2) @map("observed_value")
  expectedValue Decimal @db.Decimal(15, 2) @map("expected_value")
  deviationPct Decimal @db.Decimal(5, 2) @map("deviation_pct")

  // Root cause analysis: [{cause, probability, evidence, recommendation}]
  likelyCauses Json @map("likely_causes")
  primaryCause String? @map("primary_cause")
  primaryCauseConfidence Decimal? @db.Decimal(3, 2) @map("primary_cause_confidence")

  // Causal inference: DAG + treatment effects
  causalGraph Json? @map("causal_graph")
  treatmentVariable String? @map("treatment_variable")
  treatmentEffect Decimal? @db.Decimal(15, 2) @map("treatment_effect")
  treatmentEffectCiLower Decimal? @db.Decimal(15, 2) @map("treatment_effect_ci_lower")
  treatmentEffectCiUpper Decimal? @db.Decimal(15, 2) @map("treatment_effect_ci_upper")

  // Impact
  affectedCategories String[] @map("affected_categories")
  impactOnTotalEmissions Decimal @db.Decimal(5, 2) @map("impact_on_total_emissions")

  // Recommendations: [{action, expected_impact_pct, effort_level}]
  recommendations Json @map("recommendations")

  // Status & resolution
  status String @default("pending_review") @map("status") // 'pending_review' | 'investigated' | 'resolved' | 'dismissed'
  investigatedByUserId String? @map("investigated_by_user_id")
  investigatedAt DateTime? @map("investigated_at")
  resolutionNotes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, name: "causalOrg")
  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull, name: "causalFacility")
  investigatedByUser User? @relation(fields: [investigatedByUserId], references: [id], onDelete: SetNull, name: "causalInvestigator")

  @@index([organizationId, anomalyDate(sort: Desc)])
  @@index([organizationId, status])
  @@index([organizationId, primaryCauseConfidence(sort: Desc)])
  @@map("causal_analyses")
}

// ─── PHASE 5D: Distributed Processing & Batching ─────────────────────────────

model BatchJob {
  id String @id @default(cuid())
  organizationId String @map("organization_id")

  jobType String @map("job_type") // 'forecast_generation' | 'explanation_generation' | 'causal_analysis'
  status String @default("queued") @map("status") // 'queued' | 'processing' | 'completed' | 'failed'

  // Batching metrics
  totalItems Int @map("total_items")
  processedItems Int @default(0) @map("processed_items")
  batchSize Int @default(100) @map("batch_size")
  estimatedDurationSeconds Int? @map("estimated_duration_seconds")

  // Results & errors
  results Json? @map("results")
  errorMessage String?

  // Timing
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, name: "batchJobOrg")

  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("batch_jobs")
}

// ─── PHASE 5E: Dashboard Cache (Fast Queries for Analytics) ───────────────────

model AnalyticsDashboardCache {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  reportingPeriodId String @map("reporting_period_id")

  // Forecast summary
  forecastTotalCo2e Decimal? @db.Decimal(15, 2) @map("forecast_total_co2e")
  forecastTrend String? @map("forecast_trend") // 'increasing' | 'decreasing' | 'stable'
  forecastConfidence Decimal? @db.Decimal(3, 2) @map("forecast_confidence")

  // Top drivers from explainability
  topDriverFeature String? @map("top_driver_feature")
  topDriverPct Decimal? @db.Decimal(5, 2) @map("top_driver_pct")
  topFiveFeatures Json? @map("top_five_features") // [{name, importance_pct}]

  // Anomalies & root causes
  recentAnomaliesCount Int @default(0) @map("recent_anomalies_count")
  unresolvedAnomaliesCount Int @default(0) @map("unresolved_anomalies_count")
  recentRootCauses Json? @map("recent_root_causes") // [{anomaly, primary_cause, confidence}]

  // What-if scenarios
  scenarioResults Json? @map("scenario_results") // [{scenario_name, forecasted_value, change_pct}]

  // Last run timestamps
  lastForecastRun DateTime? @map("last_forecast_run")
  lastExplanationRun DateTime? @map("last_explanation_run")
  lastCausalAnalysisRun DateTime? @map("last_causal_analysis")

  cachedAt DateTime @default(now()) @map("cached_at")
  expiresAt DateTime @default(dbgenerated("NOW() + INTERVAL '24 hours'")) @map("expires_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, name: "dashboardCacheOrg")
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade, name: "dashboardCachePeriod")

  @@unique([organizationId, reportingPeriodId])
  @@index([organizationId, cachedAt(sort: Desc)])
  @@index([organizationId, expiresAt])
  @@map("analytics_dashboard_cache")
}


// ─── In-app notifications (notification centre) ──────────────────────────────
// Persisted copy of every notification that also goes out via email/push, so
// users have an in-app feed + unread badge. Scalar FK columns only (no Prisma
// relations) — scoped in application code by (organizationId, userId), matching
// the multi-tenant query rules.
model Notification {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  type           String    @map("type") // NotificationJobData.type value
  title          String    @map("title")
  body           String    @map("body")
  link           String?   @map("link") // in-app deep link (path)
  resourceId     String?   @map("resource_id")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([userId, organizationId, readAt, createdAt(sort: Desc)])
  @@index([userId, organizationId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventory foundation: organisational boundary, data provenance, base year
// and restatements. These implement GHG Protocol Corporate Standard chapters
// 3 (organisational boundaries), 5 (base year and recalculation) and 9
// (reporting / restatement disclosure).
// ─────────────────────────────────────────────────────────────────────────────

/// GHG Protocol Chapter 3 consolidation approaches.
enum ConsolidationApproach {
  /// Consolidate 100% of emissions from operations over which the company has
  /// authority to introduce and implement operating policies.
  operational_control
  /// Consolidate 100% of emissions from operations it financially controls.
  financial_control
  /// Consolidate emissions in proportion to the company's equity share.
  equity_share
}

/// How an activity figure was obtained, ordered from strongest to weakest.
/// Assurance sampling and the ESRS E1 / CDP primary-vs-secondary data split
/// both key off this.
enum DataOrigin {
  /// Read from a physical or smart meter.
  metered
  /// Taken from a supplier invoice or delivery note quantity.
  invoiced
  /// Supplier-specific figure from a supplier's own verified inventory or EPD.
  supplier_specific
  /// Derived from other measured values by a documented calculation.
  calculated
  /// Estimated from an average, model or engineering judgement.
  estimated
  /// A stand-in from a comparable site, period or activity.
  proxy
  /// Scaled from a partial period or partial population.
  extrapolated
}

/// Events that oblige a base year recalculation under GHG Protocol Chapter 5.
enum StructuralChangeType {
  acquisition
  divestiture
  merger
  outsourcing
  insourcing
  /// Change of calculation methodology, emission factor set or GWP set.
  methodology_change
  /// Change of the organisational boundary or consolidation approach.
  boundary_change
  /// Discovery of a material error in previously reported figures.
  error_correction
}

enum BaseYearStatus {
  draft
  active
  superseded
}

enum RecalculationStatus {
  pending
  /// Assessed as below the significance threshold, so no restatement is made.
  not_significant
  /// Above threshold and awaiting approval.
  awaiting_approval
  approved
  rejected
}

/// Reason codes for restating a previously published figure.
enum RestatementReason {
  structural_change
  methodology_change
  factor_revision
  error_correction
  improved_data
  boundary_change
}

/// A legal entity inside the reporting group. The consolidation approach on
/// Organization decides how each entity's emissions roll up.
model LegalEntity {
  id                 String   @id @default(cuid())
  organizationId     String   @map("organization_id")
  name               String
  registrationNumber String?  @map("registration_number")
  country            String?
  /// Self-referencing parent, so a group hierarchy of any depth can be modelled.
  parentId           String?  @map("parent_id")
  /// Equity share held by the parent, 0-100. Used under the equity_share approach.
  ownershipPercent   Decimal  @default(100) @map("ownership_percent") @db.Decimal(6, 3)
  /// Whether the group has operational control, used under operational_control.
  operationalControl Boolean  @default(true) @map("operational_control")
  /// Whether the group has financial control, used under financial_control.
  financialControl   Boolean  @default(true) @map("financial_control")
  /// Date the entity entered the group. Emissions before this are excluded.
  acquiredOn         DateTime? @map("acquired_on") @db.Date
  /// Date the entity left the group. Emissions after this are excluded.
  divestedOn         DateTime? @map("divested_on") @db.Date
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization      Organization       @relation("OrgLegalEntities", fields: [organizationId], references: [id], onDelete: Cascade)
  parent            LegalEntity?       @relation("LegalEntityTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          LegalEntity[]      @relation("LegalEntityTree")
  facilities        Facility[]         @relation("LegalEntityFacilities")
  structuralChanges StructuralChange[] @relation("StructuralChangeEntity")

  @@index([organizationId])
  @@index([organizationId, parentId])
  @@map("legal_entities")
}

/// The reference year every reduction target and trend line is measured
/// against. Exactly one base year per organisation may be active at a time.
model BaseYear {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  reportingPeriodId String   @map("reporting_period_id")
  label             String
  rationale         String?
  /// Percentage change in base year total that triggers a restatement.
  /// GHG Protocol suggests a policy threshold; 5% is the common choice.
  significanceThresholdPercent Decimal @default(5) @map("significance_threshold_percent") @db.Decimal(6, 3)
  status            BaseYearStatus @default(draft)
  /// Frozen totals as originally published, in tCO2e.
  originalScope1Co2e Decimal? @map("original_scope1_co2e") @db.Decimal(18, 6)
  originalScope2Co2e Decimal? @map("original_scope2_co2e") @db.Decimal(18, 6)
  originalScope3Co2e Decimal? @map("original_scope3_co2e") @db.Decimal(18, 6)
  originalTotalCo2e  Decimal? @map("original_total_co2e") @db.Decimal(18, 6)
  /// Current totals after all approved recalculations, in tCO2e.
  currentScope1Co2e  Decimal? @map("current_scope1_co2e") @db.Decimal(18, 6)
  currentScope2Co2e  Decimal? @map("current_scope2_co2e") @db.Decimal(18, 6)
  currentScope3Co2e  Decimal? @map("current_scope3_co2e") @db.Decimal(18, 6)
  currentTotalCo2e   Decimal? @map("current_total_co2e") @db.Decimal(18, 6)
  lockedAt          DateTime? @map("locked_at")
  createdByUserId   String   @map("created_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization    Organization            @relation("OrgBaseYears", fields: [organizationId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod         @relation("BaseYearPeriod", fields: [reportingPeriodId], references: [id])
  createdBy       User                    @relation("BaseYearCreator", fields: [createdByUserId], references: [id])
  recalculations  BaseYearRecalculation[] @relation("BaseYearRecalcs")

  @@index([organizationId, status])
  @@map("base_years")
}

/// A change to the reporting group or methodology that may oblige a base year
/// recalculation. Logging the change is mandatory even when the assessed
/// impact turns out to be below the significance threshold.
model StructuralChange {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  type           StructuralChangeType
  effectiveDate  DateTime             @map("effective_date") @db.Date
  description    String
  /// Entity acquired, divested or otherwise affected, when applicable.
  legalEntityId  String?              @map("legal_entity_id")
  /// Estimated tCO2e the change adds to or removes from the base year.
  estimatedImpactCo2e Decimal?        @map("estimated_impact_co2e") @db.Decimal(18, 6)
  notes          String?
  createdByUserId String              @map("created_by_user_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization   Organization            @relation("OrgStructuralChanges", fields: [organizationId], references: [id], onDelete: Cascade)
  legalEntity    LegalEntity?            @relation("StructuralChangeEntity", fields: [legalEntityId], references: [id], onDelete: SetNull)
  createdBy      User                    @relation("StructuralChangeCreator", fields: [createdByUserId], references: [id])
  recalculations BaseYearRecalculation[] @relation("RecalcTrigger")

  @@index([organizationId, effectiveDate])
  @@map("structural_changes")
}

/// The assessment of one structural change against one base year: what the
/// base year total was, what it becomes, and whether that crosses the
/// significance threshold and therefore requires restatement.
model BaseYearRecalculation {
  id                 String              @id @default(cuid())
  organizationId     String              @map("organization_id")
  baseYearId         String              @map("base_year_id")
  structuralChangeId String              @map("structural_change_id")
  status             RecalculationStatus @default(pending)
  /// Base year totals before this recalculation, in tCO2e.
  previousScope1Co2e Decimal? @map("previous_scope1_co2e") @db.Decimal(18, 6)
  previousScope2Co2e Decimal? @map("previous_scope2_co2e") @db.Decimal(18, 6)
  previousScope3Co2e Decimal? @map("previous_scope3_co2e") @db.Decimal(18, 6)
  previousTotalCo2e  Decimal? @map("previous_total_co2e") @db.Decimal(18, 6)
  /// Base year totals after this recalculation, in tCO2e.
  restatedScope1Co2e Decimal? @map("restated_scope1_co2e") @db.Decimal(18, 6)
  restatedScope2Co2e Decimal? @map("restated_scope2_co2e") @db.Decimal(18, 6)
  restatedScope3Co2e Decimal? @map("restated_scope3_co2e") @db.Decimal(18, 6)
  restatedTotalCo2e  Decimal? @map("restated_total_co2e") @db.Decimal(18, 6)
  /// Signed percentage change in the total, used against the threshold.
  deltaPercent       Decimal? @map("delta_percent") @db.Decimal(10, 4)
  /// True when abs(deltaPercent) >= the base year significance threshold.
  isSignificant      Boolean  @default(false) @map("is_significant")
  method             String?
  notes              String?
  approvedByUserId   String?  @map("approved_by_user_id")
  approvedAt         DateTime? @map("approved_at")
  createdByUserId    String   @map("created_by_user_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization     Organization     @relation("OrgBaseYearRecalcs", fields: [organizationId], references: [id], onDelete: Cascade)
  baseYear         BaseYear         @relation("BaseYearRecalcs", fields: [baseYearId], references: [id], onDelete: Cascade)
  structuralChange StructuralChange @relation("RecalcTrigger", fields: [structuralChangeId], references: [id], onDelete: Cascade)
  createdBy        User             @relation("RecalcCreator", fields: [createdByUserId], references: [id])
  approvedBy       User?            @relation("RecalcApprover", fields: [approvedByUserId], references: [id])

  @@unique([baseYearId, structuralChangeId])
  @@index([organizationId, status])
  @@map("base_year_recalculations")
}

/// A disclosed change to a previously published figure. Frameworks require
/// restatements to be reported with the reason and the magnitude, so this is
/// an append-only public record rather than an edit to the original snapshot.
model Restatement {
  id                    String            @id @default(cuid())
  organizationId        String            @map("organization_id")
  /// The snapshot whose figures are being corrected.
  supersededSnapshotId  String            @map("superseded_snapshot_id")
  /// The snapshot that now carries the correct figures, once published.
  replacementSnapshotId String?           @map("replacement_snapshot_id")
  reason                RestatementReason
  description           String
  previousTotalCo2e     Decimal? @map("previous_total_co2e") @db.Decimal(18, 6)
  restatedTotalCo2e     Decimal? @map("restated_total_co2e") @db.Decimal(18, 6)
  deltaPercent          Decimal? @map("delta_percent") @db.Decimal(10, 4)
  /// Whether the change crosses the organisation's materiality threshold and
  /// therefore must be disclosed in the published report.
  isMaterial            Boolean  @default(false) @map("is_material")
  disclosedAt           DateTime? @map("disclosed_at")
  createdByUserId       String   @map("created_by_user_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization        Organization       @relation("OrgRestatements", fields: [organizationId], references: [id], onDelete: Cascade)
  supersededSnapshot  PublishedSnapshot  @relation("RestatementSuperseded", fields: [supersededSnapshotId], references: [id], onDelete: Cascade)
  replacementSnapshot PublishedSnapshot? @relation("RestatementReplacement", fields: [replacementSnapshotId], references: [id], onDelete: SetNull)
  createdBy           User               @relation("RestatementCreator", fields: [createdByUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([supersededSnapshotId])
  @@map("restatements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Environmental management: permits and consents, the legal register, the
// incident and non-conformance register with corrective actions, and the
// ISO 14001 aspects and impacts register.
//
// This is the non-carbon half of an environmental function. A carbon
// inventory alone does not discharge an operator's statutory duties.
// ─────────────────────────────────────────────────────────────────────────────

enum PermitType {
  /// Environmental permit under the Environmental Permitting Regulations.
  environmental_permit
  /// Consent to discharge trade effluent to sewer or controlled waters.
  discharge_consent
  /// Licence to abstract water.
  abstraction_licence
  /// Waste carrier, broker or dealer registration.
  waste_carrier_licence
  /// Permit or exemption for a waste management operation.
  waste_management_licence
  /// Emissions to air permit for a regulated process.
  air_emissions_permit
  /// Licence to hold or use radioactive substances.
  radioactive_substances
  /// Licence covering protected species or habitats.
  species_licence
  /// Planning consent condition with an environmental obligation.
  planning_condition
  other
}

enum PermitStatus {
  draft
  applied
  active
  /// Expired without renewal. Operating on an expired permit is an offence.
  expired
  suspended
  revoked
  surrendered
}

enum ComplianceStatus {
  compliant
  /// Compliant now but drifting, or an early-warning trigger has fired.
  at_risk
  breach
  not_assessed
}

enum IncidentType {
  spill
  /// Discharge or emission above a permitted limit.
  exceedance
  /// Release to air, water or land outside permitted conditions.
  unauthorised_release
  complaint
  /// Something that could have caused harm but did not.
  near_miss
  waste_misrouting
  /// Failure of abatement, containment or monitoring equipment.
  equipment_failure
  /// Ecological or protected species harm.
  ecological_damage
  other
}

enum IncidentSeverity {
  /// No environmental harm, no reporting duty.
  negligible
  minor
  moderate
  major
  /// Significant harm or a mandatory notification to the regulator.
  severe
}

enum IncidentStatus {
  reported
  investigating
  /// Immediate containment done, root cause work continuing.
  contained
  awaiting_action
  closed
}

enum CorrectiveActionStatus {
  open
  in_progress
  /// Action done, waiting on someone to confirm it worked.
  awaiting_verification
  verified
  overdue
  cancelled
}

enum ActionType {
  /// Stops the immediate harm.
  containment
  /// Fixes this occurrence.
  corrective
  /// Stops it happening again.
  preventive
}

/// ISO 14001 significance rating for an environmental aspect.
enum AspectSignificance {
  low
  medium
  high
  /// Significant aspect requiring an objective, target or operational control.
  significant
}

/// A permit, consent, licence or registration the organisation holds.
model EnvironmentalPermit {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  facilityId     String?      @map("facility_id")
  siteId         String?      @map("site_id")
  type           PermitType
  reference      String
  issuingAuthority String     @map("issuing_authority")
  title          String
  description    String?
  status         PermitStatus @default(active)
  issuedOn       DateTime?    @map("issued_on") @db.Date
  effectiveFrom  DateTime?    @map("effective_from") @db.Date
  /// Null means the permit does not expire. A date in the past with status
  /// active is a compliance breach the dashboard surfaces.
  expiresOn      DateTime?    @map("expires_on") @db.Date
  /// Lead time in days for starting the renewal application.
  renewalNoticeDays Int       @default(90) @map("renewal_notice_days")
  ownerUserId    String?      @map("owner_user_id")
  documentEvidenceId String?  @map("document_evidence_id")
  notes          String?
  createdByUserId String      @map("created_by_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization      @relation("OrgPermits", fields: [organizationId], references: [id], onDelete: Cascade)
  facility     Facility?         @relation("FacilityPermits", fields: [facilityId], references: [id], onDelete: SetNull)
  site         Site?             @relation("SitePermits", fields: [siteId], references: [id], onDelete: SetNull)
  owner        User?             @relation("PermitOwner", fields: [ownerUserId], references: [id])
  createdBy    User              @relation("PermitCreator", fields: [createdByUserId], references: [id])
  conditions   PermitCondition[] @relation("PermitConditions")
  incidents    EnvironmentalIncident[] @relation("IncidentPermit")

  @@unique([organizationId, reference])
  @@index([organizationId, status, expiresOn])
  @@index([organizationId, facilityId])
  @@map("environmental_permits")
}

/// One numbered condition attached to a permit. Compliance is tracked per
/// condition, not per permit, because that is how a regulator inspects.
model PermitCondition {
  id            String           @id @default(cuid())
  organizationId String          @map("organization_id")
  permitId      String           @map("permit_id")
  reference     String
  description   String
  /// Numeric limit the condition imposes, where it has one.
  limitValue    Decimal?         @map("limit_value") @db.Decimal(18, 6)
  limitUnit     String?          @map("limit_unit")
  /// How often compliance must be demonstrated, e.g. monthly, quarterly.
  monitoringFrequency String?    @map("monitoring_frequency")
  complianceStatus ComplianceStatus @default(not_assessed) @map("compliance_status")
  lastAssessedOn DateTime?       @map("last_assessed_on") @db.Date
  nextDueOn     DateTime?        @map("next_due_on") @db.Date
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  organization Organization        @relation("OrgPermitConditions", fields: [organizationId], references: [id], onDelete: Cascade)
  permit       EnvironmentalPermit @relation("PermitConditions", fields: [permitId], references: [id], onDelete: Cascade)

  @@index([organizationId, permitId])
  @@index([organizationId, complianceStatus, nextDueOn])
  @@map("permit_conditions")
}

/// The register of environmental legislation applicable to the organisation,
/// with the compliance position against each entry. ISO 14001 clause 6.1.3
/// requires this to exist and be kept current.
model LegalRegisterEntry {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  /// Short name, e.g. "Environmental Permitting (England and Wales) Regulations 2016".
  title          String
  citation       String?
  /// Jurisdiction the instrument applies in, e.g. "England and Wales".
  jurisdiction   String?
  /// Which part of the business it bites on.
  applicability  String
  /// What the organisation must actually do to comply.
  obligation     String
  complianceStatus ComplianceStatus @default(not_assessed) @map("compliance_status")
  /// Evidence demonstrating compliance, described in words.
  evidenceSummary String?         @map("evidence_summary")
  ownerUserId    String?          @map("owner_user_id")
  lastReviewedOn DateTime?        @map("last_reviewed_on") @db.Date
  /// ISO 14001 expects periodic re-evaluation of compliance obligations.
  nextReviewOn   DateTime?        @map("next_review_on") @db.Date
  referenceUrl   String?          @map("reference_url")
  notes          String?
  createdByUserId String          @map("created_by_user_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation("OrgLegalRegister", fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("LegalRegisterOwner", fields: [ownerUserId], references: [id])
  createdBy    User         @relation("LegalRegisterCreator", fields: [createdByUserId], references: [id])

  @@index([organizationId, complianceStatus])
  @@index([organizationId, nextReviewOn])
  @@map("legal_register_entries")
}

/// An environmental incident, near miss, complaint or non-conformance.
/// Keeping this register is a statutory expectation for most permitted
/// operators and a certification requirement under ISO 14001.
model EnvironmentalIncident {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  reference      String
  type           IncidentType
  severity       IncidentSeverity
  status         IncidentStatus   @default(reported)
  occurredAt     DateTime         @map("occurred_at")
  discoveredAt   DateTime?        @map("discovered_at")
  facilityId     String?          @map("facility_id")
  siteId         String?          @map("site_id")
  projectId      String?          @map("project_id")
  permitId       String?          @map("permit_id")
  description    String
  immediateAction String?         @map("immediate_action")
  rootCause      String?          @map("root_cause")
  /// Environmental medium affected: air, water, land, or a combination.
  affectedMedium String?          @map("affected_medium")
  estimatedQuantity Decimal?      @map("estimated_quantity") @db.Decimal(18, 6)
  quantityUnit   String?          @map("quantity_unit")
  /// Whether the regulator has to be told. Severe incidents almost always are.
  regulatorNotifiable Boolean     @default(false) @map("regulator_notifiable")
  regulatorNotifiedAt DateTime?   @map("regulator_notified_at")
  regulatorReference String?      @map("regulator_reference")
  reportedByUserId String?        @map("reported_by_user_id")
  ownerUserId    String?          @map("owner_user_id")
  closedAt       DateTime?        @map("closed_at")
  createdByUserId String          @map("created_by_user_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization         @relation("OrgIncidents", fields: [organizationId], references: [id], onDelete: Cascade)
  facility     Facility?            @relation("FacilityIncidents", fields: [facilityId], references: [id], onDelete: SetNull)
  site         Site?                @relation("SiteIncidents", fields: [siteId], references: [id], onDelete: SetNull)
  project      Project?             @relation("ProjectIncidents", fields: [projectId], references: [id], onDelete: SetNull)
  permit       EnvironmentalPermit? @relation("IncidentPermit", fields: [permitId], references: [id], onDelete: SetNull)
  reportedBy   User?                @relation("IncidentReporter", fields: [reportedByUserId], references: [id])
  owner        User?                @relation("IncidentOwner", fields: [ownerUserId], references: [id])
  createdBy    User                 @relation("IncidentCreator", fields: [createdByUserId], references: [id])
  actions      CorrectiveAction[]   @relation("IncidentActions")

  @@unique([organizationId, reference])
  @@index([organizationId, status, occurredAt])
  @@index([organizationId, severity, occurredAt])
  @@index([organizationId, facilityId])
  @@map("environmental_incidents")
}

/// A containment, corrective or preventive action arising from an incident.
/// An incident cannot be closed while it has open actions.
model CorrectiveAction {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  incidentId     String                 @map("incident_id")
  type           ActionType
  description    String
  status         CorrectiveActionStatus @default(open)
  assignedToUserId String?              @map("assigned_to_user_id")
  dueOn          DateTime?              @map("due_on") @db.Date
  completedAt    DateTime?              @map("completed_at")
  /// Someone other than the doer confirms the action actually worked.
  verifiedByUserId String?              @map("verified_by_user_id")
  verifiedAt     DateTime?              @map("verified_at")
  verificationNote String?              @map("verification_note")
  createdByUserId String                @map("created_by_user_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization Organization          @relation("OrgCorrectiveActions", fields: [organizationId], references: [id], onDelete: Cascade)
  incident     EnvironmentalIncident @relation("IncidentActions", fields: [incidentId], references: [id], onDelete: Cascade)
  assignedTo   User?                 @relation("ActionAssignee", fields: [assignedToUserId], references: [id])
  verifiedBy   User?                 @relation("ActionVerifier", fields: [verifiedByUserId], references: [id])
  createdBy    User                  @relation("ActionCreator", fields: [createdByUserId], references: [id])

  @@index([organizationId, status, dueOn])
  @@index([organizationId, incidentId])
  @@map("corrective_actions")
}

/// ISO 14001 clause 6.1.2 aspects and impacts register. An activity has an
/// environmental aspect, which causes an impact, rated for significance under
/// normal, abnormal and emergency conditions.
model EnvironmentalAspect {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  facilityId     String?            @map("facility_id")
  activity       String
  aspect         String
  impact         String
  /// normal, abnormal or emergency operating condition.
  operatingCondition String         @default("normal") @map("operating_condition")
  /// Scoring inputs, each 1-5, multiplied into the significance score.
  severityScore    Int              @default(1) @map("severity_score")
  likelihoodScore  Int              @default(1) @map("likelihood_score")
  /// Legal or regulatory exposure the aspect carries.
  legalScore       Int              @default(1) @map("legal_score")
  /// severity x likelihood x legal, stored so the register can be sorted and
  /// filtered without recomputing across the whole table.
  significanceScore Int             @default(1) @map("significance_score")
  significance     AspectSignificance @default(low)
  existingControls String?          @map("existing_controls")
  /// Further action needed where the aspect is significant.
  furtherAction    String?          @map("further_action")
  ownerUserId      String?          @map("owner_user_id")
  lastReviewedOn   DateTime?        @map("last_reviewed_on") @db.Date
  nextReviewOn     DateTime?        @map("next_review_on") @db.Date
  createdByUserId  String           @map("created_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization Organization @relation("OrgAspects", fields: [organizationId], references: [id], onDelete: Cascade)
  facility     Facility?    @relation("FacilityAspects", fields: [facilityId], references: [id], onDelete: SetNull)
  owner        User?        @relation("AspectOwner", fields: [ownerUserId], references: [id])
  createdBy    User         @relation("AspectCreator", fields: [createdByUserId], references: [id])

  @@index([organizationId, significance])
  @@index([organizationId, facilityId])
  @@map("environmental_aspects")
}

// ─────────────────────────────────────────────────────────────────────────────
// Ecology: Biodiversity Net Gain, protected species, and the 30 year
// management and monitoring obligation that follows a BNG consent.
//
// BNG has been mandatory for development in England since February 2024. A
// scheme must deliver at least a 10% uplift in biodiversity units, measured
// with the statutory metric, in each of three modules independently, and
// secure it for 30 years through a planning obligation or a conservation
// covenant.
// ─────────────────────────────────────────────────────────────────────────────

enum BiodiversityModule {
  /// Area habitats, measured in hectares.
  area
  /// Hedgerows and lines of trees, measured in kilometres.
  hedgerow
  /// Rivers and streams, measured in kilometres.
  watercourse
}

enum HabitatDistinctiveness {
  very_low
  low
  medium
  high
  very_high
}

enum HabitatCondition {
  not_assessed
  poor
  fairly_poor
  moderate
  fairly_good
  good
}

enum StrategicSignificance {
  low
  medium
  high
}

enum CreationDifficulty {
  low
  medium
  high
  very_high
}

enum SpatialRisk {
  on_site
  outside_neighbouring
  outside_distant
}

/// Whether a parcel describes the site before development or after.
enum ParcelStage {
  baseline
  /// Habitat retained unchanged through the development.
  retained
  /// Existing habitat improved to a better condition.
  enhanced
  /// New habitat created where there was none of that type.
  created
}

enum AssessmentStatus {
  draft
  /// Submitted with a planning application.
  submitted
  approved
  /// Superseded by a later revision of the assessment.
  superseded
}

/// How the net gain is legally secured for 30 years.
enum SecuringMechanism {
  /// Planning obligation under s106 of the Town and Country Planning Act 1990.
  section_106
  /// Conservation covenant under the Environment Act 2021.
  conservation_covenant
  /// Planning condition, available only for on-site gains.
  planning_condition
  /// Statutory biodiversity credits bought from the government.
  statutory_credits
  not_yet_secured
}

enum SpeciesLicenceStatus {
  not_required
  required
  applied
  granted
  refused
  expired
}

enum MonitoringEventStatus {
  scheduled
  due
  completed
  overdue
  /// Monitoring found the habitat failing against its target condition.
  remediation_required
  waived
}

/// A Biodiversity Net Gain assessment for a project or site, holding the
/// balance across all three metric modules.
model BiodiversityAssessment {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  projectId      String?          @map("project_id")
  siteId         String?          @map("site_id")
  name           String
  reference      String?
  status         AssessmentStatus @default(draft)
  /// Version of the statutory metric the assessment was produced with.
  metricVersion  String           @default("statutory-biodiversity-metric") @map("metric_version")
  /// Local planning authority the application sits with.
  planningAuthority String?       @map("planning_authority")
  planningReference String?       @map("planning_reference")
  assessmentDate DateTime?        @map("assessment_date") @db.Date
  /// Ecologist responsible for the survey and the metric calculation.
  ecologistName  String?          @map("ecologist_name")
  ecologistOrganisation String?   @map("ecologist_organisation")

  /// Rolled-up unit totals, recomputed whenever a parcel changes. Stored so
  /// the register can be listed and filtered without recalculating every
  /// parcel on every request.
  baselineAreaUnits         Decimal @default(0) @map("baseline_area_units") @db.Decimal(18, 6)
  baselineHedgerowUnits     Decimal @default(0) @map("baseline_hedgerow_units") @db.Decimal(18, 6)
  baselineWatercourseUnits  Decimal @default(0) @map("baseline_watercourse_units") @db.Decimal(18, 6)
  postAreaUnits             Decimal @default(0) @map("post_area_units") @db.Decimal(18, 6)
  postHedgerowUnits         Decimal @default(0) @map("post_hedgerow_units") @db.Decimal(18, 6)
  postWatercourseUnits      Decimal @default(0) @map("post_watercourse_units") @db.Decimal(18, 6)
  /// Whether every engaged module independently meets the statutory 10%.
  meetsRequirement          Boolean @default(false) @map("meets_requirement")

  securingMechanism SecuringMechanism @default(not_yet_secured) @map("securing_mechanism")
  /// Start of the 30 year maintenance and monitoring obligation.
  securedFrom       DateTime?         @map("secured_from") @db.Date
  notes             String?
  createdByUserId   String            @map("created_by_user_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization    Organization              @relation("OrgBiodiversity", fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?                  @relation("ProjectBiodiversity", fields: [projectId], references: [id], onDelete: SetNull)
  site            Site?                     @relation("SiteBiodiversity", fields: [siteId], references: [id], onDelete: SetNull)
  createdBy       User                      @relation("BiodiversityCreator", fields: [createdByUserId], references: [id])
  parcels         HabitatParcel[]           @relation("AssessmentParcels")
  speciesRecords  ProtectedSpeciesRecord[]  @relation("AssessmentSpecies")
  managementPlan  HabitatManagementPlan?    @relation("AssessmentPlan")

  @@index([organizationId, status])
  @@index([organizationId, projectId])
  @@map("biodiversity_assessments")
}

/// One habitat parcel in an assessment, either as surveyed or as proposed.
/// Units are computed server side from the metric inputs and stored, so a
/// parcel can never hold a unit figure that disagrees with its own inputs.
model HabitatParcel {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  assessmentId   String                 @map("assessment_id")
  stage          ParcelStage
  module         BiodiversityModule
  /// UK Habitat Classification broad habitat, used by the trading rules.
  broadHabitat   String                 @map("broad_habitat")
  /// The specific habitat type within that broad habitat.
  habitatType    String                 @map("habitat_type")
  /// Hectares for area habitats, kilometres for hedgerows and watercourses.
  size           Decimal                @db.Decimal(14, 4)
  distinctiveness HabitatDistinctiveness
  condition      HabitatCondition       @default(not_assessed)
  strategicSignificance StrategicSignificance @default(low) @map("strategic_significance")

  /// The three risk multipliers, which apply only to created and enhanced
  /// parcels. Retained and baseline parcels leave them at their neutral values.
  difficulty     CreationDifficulty     @default(low)
  yearsToTargetCondition Int            @default(0) @map("years_to_target_condition")
  spatialRisk    SpatialRisk            @default(on_site) @map("spatial_risk")

  /// Computed biodiversity units for this parcel.
  units          Decimal                @default(0) @db.Decimal(18, 6)
  /// The arithmetic that produced the units, kept for the audit trail so an
  /// ecologist or a planning officer can check the figure without rerunning it.
  calculation    String?
  parcelReference String?               @map("parcel_reference")
  notes          String?
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization Organization           @relation("OrgHabitatParcels", fields: [organizationId], references: [id], onDelete: Cascade)
  assessment   BiodiversityAssessment @relation("AssessmentParcels", fields: [assessmentId], references: [id], onDelete: Cascade)
  monitoringEvents EcologicalMonitoringEvent[] @relation("ParcelMonitoring")

  @@index([organizationId, assessmentId])
  @@index([assessmentId, stage, module])
  @@map("habitat_parcels")
}

/// A protected species record: what was found, what licence it needs, and
/// whether that licence is in place. Working without one where it is required
/// is a criminal offence, so licence status is tracked separately from survey.
model ProtectedSpeciesRecord {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  assessmentId   String?              @map("assessment_id")
  siteId         String?              @map("site_id")
  projectId      String?              @map("project_id")
  species        String
  /// Legal protection relied on, e.g. "Schedule 5 WCA 1981", "Habitats Regs Annex IV".
  legalProtection String?             @map("legal_protection")
  surveyDate     DateTime?            @map("survey_date") @db.Date
  surveyorName   String?              @map("survey_name")
  /// What was recorded: presence, absence, evidence of use, a roost, a sett.
  findings       String
  /// Whether the works can proceed without a licence.
  licenceStatus  SpeciesLicenceStatus @default(not_required) @map("licence_status")
  licenceReference String?            @map("licence_reference")
  licenceExpiresOn DateTime?          @map("licence_expires_on") @db.Date
  /// Mitigation or method statement the licence depends on.
  mitigation     String?
  /// Seasonal constraint on when works may take place.
  seasonalConstraint String?          @map("seasonal_constraint")
  notes          String?
  createdByUserId String              @map("created_by_user_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization Organization            @relation("OrgSpeciesRecords", fields: [organizationId], references: [id], onDelete: Cascade)
  assessment   BiodiversityAssessment? @relation("AssessmentSpecies", fields: [assessmentId], references: [id], onDelete: SetNull)
  site         Site?                   @relation("SiteSpeciesRecords", fields: [siteId], references: [id], onDelete: SetNull)
  project      Project?                @relation("ProjectSpeciesRecords", fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User                    @relation("SpeciesRecordCreator", fields: [createdByUserId], references: [id])

  @@index([organizationId, licenceStatus])
  @@index([organizationId, assessmentId])
  @@map("protected_species_records")
}

/// The landscape and ecological management plan securing a net gain for its
/// 30 year obligation period.
model HabitatManagementPlan {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  assessmentId   String   @unique @map("assessment_id")
  title          String
  /// Who is responsible for delivering the management over 30 years.
  responsibleParty String? @map("responsible_party")
  /// Start of the obligation. The monitoring schedule is generated from this.
  commencesOn    DateTime @map("commences_on") @db.Date
  /// Normally 30 years from commencement.
  endsOn         DateTime @map("ends_on") @db.Date
  managementObjectives String? @map("management_objectives")
  /// Recurring management operations, e.g. cutting regime, grazing.
  prescriptions  String?
  /// What happens if monitoring finds the habitat failing.
  remediationStrategy String? @map("remediation_strategy")
  /// Money set aside to fund the 30 years of management.
  fundingSecured Decimal? @map("funding_secured") @db.Decimal(18, 2)
  fundingCurrency String? @map("funding_currency")
  notes          String?
  createdByUserId String  @map("created_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization                @relation("OrgManagementPlans", fields: [organizationId], references: [id], onDelete: Cascade)
  assessment   BiodiversityAssessment      @relation("AssessmentPlan", fields: [assessmentId], references: [id], onDelete: Cascade)
  createdBy    User                        @relation("ManagementPlanCreator", fields: [createdByUserId], references: [id])
  events       EcologicalMonitoringEvent[] @relation("PlanMonitoring")

  @@index([organizationId])
  @@map("habitat_management_plans")
}

/// One scheduled monitoring visit in the 30 year obligation. Monitoring is
/// front-loaded because created habitat fails early if it is going to fail.
model EcologicalMonitoringEvent {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  managementPlanId String              @map("management_plan_id")
  parcelId       String?               @map("parcel_id")
  /// Years since the obligation commenced.
  monitoringYear Int                   @map("monitoring_year")
  dueOn          DateTime              @map("due_on") @db.Date
  status         MonitoringEventStatus @default(scheduled)
  completedOn    DateTime?             @map("completed_on") @db.Date
  surveyorName   String?               @map("surveyor_name")
  /// Condition found on the visit, compared against the target condition.
  conditionFound HabitatCondition?     @map("condition_found")
  /// Whether the parcel is on track for its target condition.
  onTrack        Boolean?              @map("on_track")
  findings       String?
  remedialAction String?               @map("remedial_action")
  reportEvidenceId String?             @map("report_evidence_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization   Organization          @relation("OrgMonitoringEvents", fields: [organizationId], references: [id], onDelete: Cascade)
  managementPlan HabitatManagementPlan @relation("PlanMonitoring", fields: [managementPlanId], references: [id], onDelete: Cascade)
  parcel         HabitatParcel?        @relation("ParcelMonitoring", fields: [parcelId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueOn])
  @@index([managementPlanId, monitoringYear])
  @@map("ecological_monitoring_events")
}
