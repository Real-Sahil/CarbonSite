}

model SupplierAnomaly {
  id                    String    @id @default(cuid())
  organizationId        String    @map("organization_id")
  supplierDataRequestId String    @map("supplier_data_request_id")
  anomalyScore          Decimal   @map("anomaly_score") @db.Decimal(5, 4) // 0.0-1.0
  anomalySeverity       String    @map("anomaly_severity") // "warning", "critical"
  reason                String // Human-readable explanation
  flaggedFields         Json      @map("flagged_fields") // Array of { field, value, expectedRange }
  historicalAverage     Decimal?  @map("historical_average") @db.Decimal(18, 8)
  historicalStdDev      Decimal?  @map("historical_std_dev") @db.Decimal(18, 8)
  detectedAt            DateTime  @default(now()) @map("detected_at")
  acknowledgedAt        DateTime? @map("acknowledged_at")
  acknowledgedByUserId  String?   @map("acknowledged_by_user_id")
  acknowledgedNote      String?   @map("acknowledged_note")
  createdAt             DateTime  @default(now()) @map("created_at")

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierDataRequest SupplierDataRequest @relation(fields: [supplierDataRequestId], references: [id], onDelete: Cascade)
  acknowledgedBy      User?               @relation("AnomalyAcknowledger", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, anomalySeverity])
  @@index([organizationId, detectedAt])
  @@index([supplierDataRequestId])
  @@map("supplier_anomalies")
}

model ZapierIntegration {
  id                String    @id @default(cuid())
