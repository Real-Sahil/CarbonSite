  ssoUrl          String?  @map("sso_url") // For SAML
  certificateX509 String?  @map("certificate_x509") // For SAML validation
  autoCreateUsers Boolean  @default(true) @map("auto_create_users")
  autoAssignRole  String?  @default("viewer") @map("auto_assign_role") // admin | editor | reviewer | viewer | field_worker
  requireMfa      Boolean  @default(false) @map("require_mfa")
  syncAttributes  Json?    @map("sync_attributes") // Maps IdP claims to user fields
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation("SsoConfigurations", fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("sso_configurations")
}

model SsoSession {
