  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("storage_objects")
}

// ─── Production Features: Bulk Operations, Scheduling, Digests ──────────────

enum BulkOperationType {
  review
  categorize
  export
  calculate
  delete

  @@map("bulk_operation_type")
}

enum BulkOperationStatus {
  queued
  processing
  completed
  failed
  cancelled

  @@map("bulk_operation_status")
}

model BulkOperation {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  operationType  BulkOperationType   @map("operation_type")
  status         BulkOperationStatus @default(queued)
  totalCount     Int                 @map("total_count")
  processedCount Int                 @default(0) @map("processed_count")
  failedCount    Int                 @default(0) @map("failed_count")
  recordIds      String[]            @map("record_ids")
  parameters     Json
  errors         Json?
  startedAt      DateTime?           @map("started_at")
  completedAt    DateTime?           @map("completed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, operationType])
  @@index([createdAt])
  @@map("bulk_operations")
}

enum CalculationScheduleFrequency {
