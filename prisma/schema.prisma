enum DsarRequestType {
  export
  erasure

  @@map("dsar_request_type")
}

enum DsarRequestStatus {
  pending
  processing
  completed
  failed
  rejected

  @@map("dsar_request_status")
}

// Data Subject Access Requests (UK GDPR Art. 15 export / Art. 17 erasure).
// Not organization-scoped in the usual multi-tenant sense — a subject's
// data can span multiple orgs they're a member of, so organizationId is
// optional context (e.g. an org-admin-initiated request on a field
// worker's behalf), not the primary scope. See lib/compliance/pii-registry.ts.
model DsarRequest {
  id                String            @id @default(cuid())
  userId            String            @map("user_id")
  organizationId    String?           @map("organization_id")
  type              DsarRequestType
  status            DsarRequestStatus @default(pending)
  requestedAt       DateTime          @default(now()) @map("requested_at")
  // One calendar month from requestedAt (Art. 12(3) GDPR SLA), computed at
  // creation time — see app/api/account/dsar/route.ts.
  dueBy             DateTime          @map("due_by")
  completedAt       DateTime?         @map("completed_at")
  resultStorageKey  String?           @map("result_storage_key")
  requestedByUserId String            @map("requested_by_user_id")
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user            User          @relation("DsarSubject", fields: [userId], references: [id])
  requestedByUser User          @relation("DsarRequestedBy", fields: [requestedByUserId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@index([status, dueBy])
  @@index([userId])
  @@map("dsar_requests")
}

// Append-only — never update or delete rows
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  actorUserId    String?  @map("actor_user_id")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id")
  metadata       Json     @default("{}")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  // Hash chain: previousHash links to the prior row's hash within the same
  // organization, and hash covers this row's own fields. Writes are
  // serialized per-organization (pg advisory lock in writeAuditLog()) so the
  // chain can't fork under concurrent writes. chainSeq gives a deterministic
  // "latest row" ordering that doesn't depend on createdAt tie-breaking.
  previousHash   String?  @map("previous_hash")
  hash           String?  @map("hash")
  chainSeq       BigInt   @default(autoincrement()) @map("chain_seq")
  createdAt      DateTime @default(now()) @map("created_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  actor         User?          @relation(fields: [actorUserId], references: [id])
  auditContexts AuditContext[] @relation("AuditContexts")

  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, createdAt])
  @@index([organizationId, chainSeq])
  @@map("audit_logs")
}

