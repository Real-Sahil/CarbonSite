// ─── Supplier Data Requests ──────────────────────────────────────────────────

// Scope 3 supply chain data collection campaigns.
// Each request asks a supplier to self-report spend/activity data for a
// specific category and period via a pre-filled form link.
model SupplierDataRequest {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  reportingPeriodId String    @map("reporting_period_id")
  supplierEmail     String    @map("supplier_email")
  supplierName      String?   @map("supplier_name")
  categoryCode      String    @map("category_code")
  token             String    @unique @default(cuid())
  status            String    @default("sent") // sent | opened | submitted | flagged | approved | rejected | converted
  sentAt            DateTime  @default(now()) @map("sent_at")
  openedAt          DateTime? @map("opened_at")
  submittedAt       DateTime? @map("submitted_at")
  reviewedAt        DateTime? @map("reviewed_at")
  expiresAt         DateTime  @map("expires_at")
  notes             String?
  submittedData     Json?     @map("submitted_data")
  qualityFlags      Json?     @map("quality_flags") // Array of QualityFlag objects
  rejectionReason   String?   @map("rejection_reason")
  createdByUserId   String    @map("created_by_user_id")
  approvedByUserId  String?   @map("approved_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod   @relation(fields: [reportingPeriodId], references: [id])
  createdBy       User              @relation("SupplierDataRequestCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy      User?             @relation("SupplierDataRequestApprovedBy", fields: [approvedByUserId], references: [id])
  anomalies       SupplierAnomaly[]

  @@index([organizationId, reportingPeriodId])
  @@index([organizationId, status])
  @@map("supplier_data_requests")
}

